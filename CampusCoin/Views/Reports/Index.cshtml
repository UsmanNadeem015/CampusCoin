@using System.Text.Json

@{
    Layout = null;
    ViewData["Title"] = "Monthly Reports";

    var categorySummary =
        ViewBag.CategorySummary
        as List<CampusCoin.Controllers.ReportsController.CategoryReportItem>;

    var transactions =
        ViewBag.Transactions
        as List<CampusCoin.Domain.Entities.Transaction>;

    var sixMonthSummary =
        ViewBag.SixMonthSummary
        as List<CampusCoin.Controllers.ReportsController.SixMonthReportItem>;

    var dailySummary =
        ViewBag.DailySummary
        as List<CampusCoin.Controllers.ReportsController.DailyReportItem>;

    var weeklySummary =
        ViewBag.WeeklySummary
        as List<CampusCoin.Controllers.ReportsController.WeeklyReportItem>;

    var categoryLabels = categorySummary?
        .Select(x => x.CategoryName)
        .ToList()
        ?? new List<string>();

    var categoryValues = categorySummary?
        .Select(x => x.Amount)
        .ToList()
        ?? new List<decimal>();

    var sixMonthLabels = sixMonthSummary?
        .Select(x => x.Month.ToString("MMM yyyy"))
        .ToList()
        ?? new List<string>();

    var sixMonthIncome = sixMonthSummary?
        .Select(x => x.Income)
        .ToList()
        ?? new List<decimal>();

    var sixMonthExpenses = sixMonthSummary?
        .Select(x => x.Expenses)
        .ToList()
        ?? new List<decimal>();

    var dailyLabels = dailySummary?
        .Select(x => x.Date.ToString("dd MMM"))
        .ToList()
        ?? new List<string>();

    var dailyIncome = dailySummary?
        .Select(x => x.Income)
        .ToList()
        ?? new List<decimal>();

    var dailyExpenses = dailySummary?
        .Select(x => x.Expenses)
        .ToList()
        ?? new List<decimal>();

    var weeklyLabels = weeklySummary?
        .Select(x => $"{x.WeekStart:dd MMM} - {x.WeekEnd:dd MMM}")
        .ToList()
        ?? new List<string>();

    var weeklyIncome = weeklySummary?
        .Select(x => x.Income)
        .ToList()
        ?? new List<decimal>();

    var weeklyExpenses = weeklySummary?
        .Select(x => x.Expenses)
        .ToList()
        ?? new List<decimal>();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Reports</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --success: #16a34a;
            --danger: #dc2626;
            --white: #ffffff;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .main-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .nav-link {
            color: var(--brand-navy) !important;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--brand-gold) !important;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-gold {
            background: var(--brand-gold) !important;
            border-color: var(--brand-gold) !important;
            color: #ffffff !important;
        }

        .btn-gold:hover {
            background: var(--brand-gold-hover) !important;
            border-color: var(--brand-gold-hover) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .reports-header {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            padding: 42px 0 36px;
        }

        .reports-badge {
            display: inline-flex;
            align-items: center;
            background: #fff7ed;
            color: var(--brand-gold);
            border: 1px solid #fed7aa;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 0.72rem;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .reports-header h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
        }

        .reports-header p {
            margin: 9px 0 0;
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .page-content {
            flex: 1;
            padding: 35px 0 60px;
        }

        .content-panel {
            background: var(--white);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
        }

        .section-title {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 800;
        }

        .section-description {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .report-controls {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
            flex-wrap: wrap;
        }

        .month-control {
            flex: 1;
            min-width: 220px;
        }

        .month-control label {
            display: block;
            margin-bottom: 8px;
            color: var(--brand-navy);
            font-size: 0.8rem;
            font-weight: 800;
        }

        .month-control input {
            width: 100%;
            max-width: 260px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 10px 12px;
            font-family: inherit;
            color: var(--brand-navy);
            background: #ffffff;
        }

        .month-control input:focus {
            outline: none;
            border-color: var(--brand-gold);
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.12);
        }

        .report-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .summary-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 22px;
            height: 100%;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.035);
        }

        .summary-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #f8fafc;
            color: var(--brand-navy);
            font-size: 1rem;
        }

        .summary-label {
            display: block;
            color: var(--text-muted);
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 6px;
        }

        .summary-value {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 800;
        }

        .summary-income .summary-icon {
            color: var(--success);
            background: #f0fdf4;
        }

        .summary-expense .summary-icon {
            color: var(--danger);
            background: #fef2f2;
        }

        .summary-balance .summary-icon {
            color: var(--brand-gold);
            background: #fff7ed;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .dashboard-table {
            margin: 0;
            min-width: 650px;
        }

        .dashboard-table thead th {
            border-bottom: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 13px 14px;
            white-space: nowrap;
        }

        .dashboard-table tbody td {
            padding: 14px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            color: #334155;
            font-size: 0.84rem;
        }

        .dashboard-table tbody tr:last-child td {
            border-bottom: none;
        }

        .dashboard-table tbody tr:hover {
            background: #f8fafc;
        }

        .amount-income {
            color: var(--success);
            font-weight: 800;
        }

        .amount-expense {
            color: var(--danger);
            font-weight: 800;
        }

        .balance-positive {
            color: var(--success);
            font-weight: 800;
        }

        .balance-negative {
            color: var(--danger);
            font-weight: 800;
        }

        .type-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 800;
        }

        .type-income {
            background: #f0fdf4;
            color: #15803d;
        }

        .type-expense {
            background: #fef2f2;
            color: #b91c1c;
        }

        .chart-panel {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            height: 100%;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.035);
        }

        .chart-title {
            font-size: 1rem;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .chart-description {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-bottom: 22px;
        }

        .chart-container {
            position: relative;
            width: 100%;
            height: 320px;
        }

        .chart-container.large {
            height: 360px;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }

        .empty-icon {
            width: 54px;
            height: 54px;
            margin: 0 auto 14px;
            border-radius: 50%;
            background: #f8fafc;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .empty-state h3 {
            color: var(--brand-navy);
            font-size: 1rem;
            font-weight: 800;
        }

        .empty-state p {
            margin-bottom: 0;
            font-size: 0.84rem;
        }

        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            padding: 20px 0;
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        footer p {
            margin: 0;
        }

        footer strong {
            color: var(--brand-navy);
        }

        /* =========================================
           PRINT
           ========================================= */

        @@media print {

            @@page {
                size: A4 portrait;
                margin: 15mm;
            }

            html,
            body {
                background: #ffffff !important;
                display: block !important;
                min-height: 0 !important;
                height: auto !important;
            }

            .main-navbar,
            .reports-header,
            .report-actions,
            .report-controls button,
            .report-controls .btn,
            footer,
            #reportContent > .text-center {
                display: none !important;
            }

            .page-content {
                padding: 0 !important;
                display: block !important;
                flex: none !important;
            }

            .container-fluid {
                padding: 0 !important;
                max-width: 100% !important;
                width: 100% !important;
            }

            #reportContent {
                padding: 0 !important;
                display: block !important;
            }

            #reportContent > .content-panel,
            #reportContent > .row,
            #reportContent > .mb-4 {
                margin-bottom: 8mm !important;
            }

            .page-break-before {
                page-break-before: always !important;
                break-before: page !important;
                margin-top: 0 !important;
            }

            .summary-card,
            .chart-panel,
            .content-panel {
                box-shadow: none !important;
                break-inside: avoid;
                page-break-inside: avoid;
            }

            table {
                break-inside: auto !important;
                page-break-inside: auto !important;
            }

            thead {
                display: table-header-group;
            }

            tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .section-title,
            .chart-title {
                break-after: avoid;
                page-break-after: avoid;
            }

            .dashboard-table tbody tr:hover {
                background: transparent !important;
            }

            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }

        @@media (max-width: 991px) {

            .navbar-nav {
                margin-top: 12px;
            }

            .navbar-nav .nav-link {
                padding: 7px 0;
            }

            .report-actions {
                width: 100%;
            }

        }

        @@media (max-width: 768px) {

            .reports-header {
                padding: 30px 0;
            }

            .reports-header h1 {
                font-size: 1.65rem;
            }

            .page-content {
                padding-top: 25px;
            }

            .content-panel {
                padding: 18px;
            }

            .chart-panel {
                padding: 18px;
            }

            .chart-container,
            .chart-container.large {
                height: 280px;
            }

            .report-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .report-actions .btn {
                width: 100%;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg main-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Smart Student Budgeting
                    </span>

                </div>

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#studentNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse"
                 id="studentNavbar">

                <div class="navbar-nav mx-auto">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">
                        Dashboard
                    </a>

                    <a asp-controller="Transactions"
                       asp-action="Index"
                       class="nav-link">
                        Transactions
                    </a>

                    <a asp-controller="Budgets"
                       asp-action="Index"
                       class="nav-link">
                        Budgets
                    </a>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="nav-link">
                        Categories
                    </a>

                    <a asp-controller="SavingTips"
                       asp-action="Index"
                       class="nav-link">
                        Saving Tips
                    </a>

                    <a asp-controller="Bookmarks"
                       asp-action="Index"
                       class="nav-link">
                        Bookmarks
                    </a>

                    <a asp-controller="Notes"
                       asp-action="Index"
                       class="nav-link">
                        Notes
                    </a>

                </div>


                <div class="d-flex align-items-center gap-2">

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-navy btn-sm">

                        <i class="fa-solid fa-user me-1"></i>
                        Profile

                    </a>


                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-navy btn-sm">

                            <i class="fa-solid fa-right-from-bracket me-1"></i>
                            Logout

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </nav>

    <header class="reports-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="reports-badge">

                <i class="fa-solid fa-chart-line me-1"></i>
                Financial Reports

            </span>

            <h1>
                Monthly Reports
            </h1>

            <p>
                Review your income, expenses and spending patterns over time.
            </p>

        </div>

    </header>

    <main class="page-content">

        <div class="container-fluid px-4 px-lg-5"
             id="reportContent">

            <div class="content-panel mb-4">

                <div class="report-controls">

                    <div class="month-control">

                        <label for="month">
                            Select Month
                        </label>

                        <form asp-controller="Reports"
                              asp-action="Index"
                              method="get"
                              class="d-flex flex-wrap gap-2">

                            <input type="month"
                                   id="month"
                                   name="month"
                                   value="@ViewBag.SelectedMonth" />

                            <button type="submit"
                                    class="btn btn-gold">

                                <i class="fa-solid fa-chart-simple me-1"></i>
                                View Report

                            </button>

                        </form>

                    </div>


                    <div class="report-actions">

                        <button type="button"
                                class="btn btn-outline-navy"
                                onclick="window.print()">

                            <i class="fa-solid fa-print me-1"></i>
                            Print / Save as PDF

                        </button>

                        <button type="button"
                                class="btn btn-navy"
                                onclick="downloadReportImage()">

                            <i class="fa-solid fa-image me-1"></i>
                            Download Report Image

                        </button>

                    </div>

                </div>

            </div>

            <div class="mb-4">

                <h2 class="section-title">
                    @ViewBag.MonthDisplay
                </h2>

                <p class="section-description mb-0">
                    Financial overview for the selected month.
                </p>

            </div>

            <div class="row g-4 mb-5">

                <div class="col-lg-4">

                    <div class="summary-card summary-income">

                        <div class="d-flex align-items-center gap-3">

                            <div class="summary-icon">

                                <i class="fa-solid fa-arrow-trend-up"></i>

                            </div>

                            <div>

                                <span class="summary-label">
                                    Total Income
                                </span>

                                <h2 class="summary-value">
                                    Rs. @ViewBag.TotalIncome.ToString("N2")
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-4">

                    <div class="summary-card summary-expense">

                        <div class="d-flex align-items-center gap-3">

                            <div class="summary-icon">

                                <i class="fa-solid fa-arrow-trend-down"></i>

                            </div>

                            <div>

                                <span class="summary-label">
                                    Total Expenses
                                </span>

                                <h2 class="summary-value">
                                    Rs. @ViewBag.TotalExpenses.ToString("N2")
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-4">

                    <div class="summary-card summary-balance">

                        <div class="d-flex align-items-center gap-3">

                            <div class="summary-icon">

                                <i class="fa-solid fa-scale-balanced"></i>

                            </div>

                            <div>

                                <span class="summary-label">
                                    Balance
                                </span>

                                <h2 class="summary-value">
                                    Rs. @ViewBag.Balance.ToString("N2")
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="row g-4 mb-5 page-break-before">

                <div class="col-xl-6">

                    <div class="content-panel h-100">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>

                                <h2 class="section-title">
                                    Expense by Category
                                </h2>

                                <p class="section-description mb-0">
                                    Where your spending went this month.
                                </p>

                            </div>

                            <i class="fa-solid fa-chart-pie text-warning"></i>

                        </div>


                        @if (categorySummary != null &&
                            categorySummary.Count > 0)
                        {
                            <div class="table-wrapper">

                                <table class="table dashboard-table">

                                    <thead>

                                        <tr>

                                            <th>Category</th>
                                            <th>Amount</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var item in categorySummary)
                                        {
                                            <tr>

                                                <td>
                                                    @item.CategoryName
                                                </td>

                                                <td class="amount-expense">
                                                    Rs. @item.Amount.ToString("N2")
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <div class="empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-chart-pie"></i>
                                </div>

                                <h3>
                                    No Category Data
                                </h3>

                                <p>
                                    No expenses were recorded for this month.
                                </p>

                            </div>
                        }

                    </div>

                </div>


                <div class="col-xl-6">

                    <div class="chart-panel">

                        <h3 class="chart-title">
                            Spending Distribution
                        </h3>

                        <p class="chart-description">
                            Expense distribution by category.
                        </p>

                        <div class="chart-container">
                            <canvas id="categoryChart"></canvas>
                        </div>

                    </div>

                </div>

            </div>

            <div class="row g-4 mb-5 page-break-before">

                <div class="col-xl-7">

                    <div class="content-panel h-100">

                        <div class="mb-3">

                            <h2 class="section-title">
                                Six-Month Income vs Expenses
                            </h2>

                            <p class="section-description mb-0">
                                Compare your financial activity across recent months.
                            </p>

                        </div>


                        @if (sixMonthSummary != null &&
                            sixMonthSummary.Count > 0)
                        {
                            <div class="table-wrapper">

                                <table class="table dashboard-table">

                                    <thead>

                                        <tr>

                                            <th>Month</th>
                                            <th>Income</th>
                                            <th>Expenses</th>
                                            <th>Balance</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var item in sixMonthSummary)
                                        {
                                            var balance = item.Income - item.Expenses;

                                            <tr>

                                                <td>
                                                    @item.Month.ToString("MMMM yyyy")
                                                </td>

                                                <td class="amount-income">
                                                    Rs. @item.Income.ToString("N2")
                                                </td>

                                                <td class="amount-expense">
                                                    Rs. @item.Expenses.ToString("N2")
                                                </td>

                                                <td class="@(balance >= 0 ? "balance-positive" : "balance-negative")">
                                                    Rs. @balance.ToString("N2")
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <div class="empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-chart-column"></i>
                                </div>

                                <h3>
                                    No Six-Month Data
                                </h3>

                                <p>
                                    There is not enough transaction data yet.
                                </p>

                            </div>
                        }

                    </div>

                </div>


                <div class="col-xl-5">

                    <div class="chart-panel">

                        <h3 class="chart-title">
                            Monthly Comparison
                        </h3>

                        <p class="chart-description">
                            Income and expenses across the last six months.
                        </p>

                        <div class="chart-container">
                            <canvas id="sixMonthChart"></canvas>
                        </div>

                    </div>

                </div>

            </div>

            <div class="row g-4 mb-5 page-break-before">

                <div class="col-xl-8">

                    <div class="content-panel h-100">

                        <div class="mb-3">

                            <h2 class="section-title">
                                Daily Report
                            </h2>

                            <p class="section-description mb-0">
                                Daily income and expense activity for the selected month.
                            </p>

                        </div>


                        @if (dailySummary != null &&
                            dailySummary.Count > 0)
                        {
                            <div class="table-wrapper">

                                <table class="table dashboard-table">

                                    <thead>

                                        <tr>

                                            <th>Date</th>
                                            <th>Income</th>
                                            <th>Expenses</th>
                                            <th>Balance</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var item in dailySummary)
                                        {
                                            var balance = item.Income - item.Expenses;

                                            <tr>

                                                <td>
                                                    @item.Date.ToString("dd MMM yyyy")
                                                </td>

                                                <td class="amount-income">
                                                    Rs. @item.Income.ToString("N2")
                                                </td>

                                                <td class="amount-expense">
                                                    Rs. @item.Expenses.ToString("N2")
                                                </td>

                                                <td class="@(balance >= 0 ? "balance-positive" : "balance-negative")">
                                                    Rs. @balance.ToString("N2")
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <div class="empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-calendar-day"></i>
                                </div>

                                <h3>
                                    No Daily Data
                                </h3>

                                <p>
                                    No daily transaction data was found.
                                </p>

                            </div>
                        }

                    </div>

                </div>


                <div class="col-xl-4">

                    <div class="chart-panel">

                        <h3 class="chart-title">
                            Daily Activity
                        </h3>

                        <p class="chart-description">
                            Daily income versus expenses.
                        </p>

                        <div class="chart-container">
                            <canvas id="dailyChart"></canvas>
                        </div>

                    </div>

                </div>

            </div>

            <div class="row g-4 mb-5 page-break-before">

                <div class="col-xl-7">

                    <div class="content-panel h-100">

                        <div class="mb-3">

                            <h2 class="section-title">
                                Weekly Report
                            </h2>

                            <p class="section-description mb-0">
                                Weekly income and expense patterns for the selected month.
                            </p>

                        </div>


                        @if (weeklySummary != null &&
                            weeklySummary.Count > 0)
                        {
                            <div class="table-wrapper">

                                <table class="table dashboard-table">

                                    <thead>

                                        <tr>

                                            <th>Week</th>
                                            <th>Income</th>
                                            <th>Expenses</th>
                                            <th>Balance</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var item in weeklySummary)
                                        {
                                            var balance = item.Income - item.Expenses;

                                            <tr>

                                                <td>
                                                    @item.WeekStart.ToString("dd MMM")
                                                    -
                                                    @item.WeekEnd.ToString("dd MMM yyyy")
                                                </td>

                                                <td class="amount-income">
                                                    Rs. @item.Income.ToString("N2")
                                                </td>

                                                <td class="amount-expense">
                                                    Rs. @item.Expenses.ToString("N2")
                                                </td>

                                                <td class="@(balance >= 0 ? "balance-positive" : "balance-negative")">
                                                    Rs. @balance.ToString("N2")
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <div class="empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-calendar-week"></i>
                                </div>

                                <h3>
                                    No Weekly Data
                                </h3>

                                <p>
                                    No weekly transaction data was found.
                                </p>

                            </div>
                        }

                    </div>

                </div>


                <div class="col-xl-5">

                    <div class="chart-panel">

                        <h3 class="chart-title">
                            Weekly Activity
                        </h3>

                        <p class="chart-description">
                            Weekly income compared with expenses.
                        </p>

                        <div class="chart-container">
                            <canvas id="weeklyChart"></canvas>
                        </div>

                    </div>

                </div>

            </div>

            <div class="content-panel mb-5 page-break-before">

                <div class="d-flex flex-column flex-md-row
                            justify-content-between
                            align-items-md-end
                            gap-2
                            mb-3">

                    <div>

                        <h2 class="section-title">
                            Transactions
                        </h2>

                        <p class="section-description mb-0">
                            Transactions included in this month's report.
                        </p>

                    </div>

                    <a asp-controller="Transactions"
                       asp-action="Index"
                       class="btn btn-outline-navy btn-sm">

                        View All Transactions
                        <i class="fa-solid fa-arrow-right ms-1"></i>

                    </a>

                </div>


                @if (transactions != null &&
                    transactions.Count > 0)
                {
                    <div class="table-wrapper">

                        <table class="table dashboard-table">

                            <thead>

                                <tr>

                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Type</th>
                                    <th>Description</th>
                                    <th>Amount</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var transaction in transactions)
                                {
                                    var isIncome =
                                        transaction.TransactionType
                                        == CampusCoin.Domain.Enums.TransactionType.Income;

                                    <tr>

                                        <td>
                                            @transaction.TransactionDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @(transaction.Category?.Name ?? "-")
                                        </td>

                                        <td>

                                            <span class="type-badge @(isIncome ? "type-income" : "type-expense")">

                                                @(isIncome ? "Income" : "Expense")

                                            </span>

                                        </td>

                                        <td>
                                            @(transaction.Description ?? "-")
                                        </td>

                                        <td class="@(isIncome ? "amount-income" : "amount-expense")">

                                            Rs. @transaction.Amount.ToString("N2")

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">
                            <i class="fa-solid fa-receipt"></i>
                        </div>

                        <h3>
                            No Transactions
                        </h3>

                        <p>
                            No transactions were found for this month.
                        </p>

                    </div>
                }

            </div>

            <div class="text-center">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-outline-navy">

                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Back to Dashboard

                </a>

            </div>


        </div>

    </main>

    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin</strong>
                    · Smart Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>


    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const categoryLabels =
            @Html.Raw(JsonSerializer.Serialize(categoryLabels));

        const categoryValues =
            @Html.Raw(JsonSerializer.Serialize(categoryValues));


        const sixMonthLabels =
            @Html.Raw(JsonSerializer.Serialize(sixMonthLabels));

        const sixMonthIncome =
            @Html.Raw(JsonSerializer.Serialize(sixMonthIncome));

        const sixMonthExpenses =
            @Html.Raw(JsonSerializer.Serialize(sixMonthExpenses));


        const dailyLabels =
            @Html.Raw(JsonSerializer.Serialize(dailyLabels));

        const dailyIncome =
            @Html.Raw(JsonSerializer.Serialize(dailyIncome));

        const dailyExpenses =
            @Html.Raw(JsonSerializer.Serialize(dailyExpenses));


        const weeklyLabels =
            @Html.Raw(JsonSerializer.Serialize(weeklyLabels));

        const weeklyIncome =
            @Html.Raw(JsonSerializer.Serialize(weeklyIncome));

        const weeklyExpenses =
            @Html.Raw(JsonSerializer.Serialize(weeklyExpenses));


        const categoryChart = new Chart(
            document.getElementById("categoryChart"),
            {
                type: "pie",

                data: {
                    labels: categoryLabels,

                    datasets: [
                        {
                            data: categoryValues
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false
                }
            }
        );

        const sixMonthChart = new Chart(
            document.getElementById("sixMonthChart"),
            {
                type: "bar",

                data: {
                    labels: sixMonthLabels,

                    datasets: [
                        {
                            label: "Income",
                            data: sixMonthIncome
                        },
                        {
                            label: "Expenses",
                            data: sixMonthExpenses
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,

                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            }
        );

        const dailyChart = new Chart(
            document.getElementById("dailyChart"),
            {
                type: "line",

                data: {
                    labels: dailyLabels,

                    datasets: [
                        {
                            label: "Income",
                            data: dailyIncome,
                            tension: 0.3
                        },
                        {
                            label: "Expenses",
                            data: dailyExpenses,
                            tension: 0.3
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,

                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            }
        );

        const weeklyChart = new Chart(
            document.getElementById("weeklyChart"),
            {
                type: "bar",

                data: {
                    labels: weeklyLabels,

                    datasets: [
                        {
                            label: "Income",
                            data: weeklyIncome
                        },
                        {
                            label: "Expenses",
                            data: weeklyExpenses
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,

                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            }
        );

        async function downloadReportImage() {

            const report =
                document.getElementById("reportContent");

            if (!report) {
                return;
            }

            // Hide the buttons so they don't appear in the image.
            const controls =
                report.querySelector(".content-panel .report-controls");

            if (controls) {
                controls.style.display = "none";
            }

            const chartMap = [
                { canvas: document.getElementById("categoryChart"), chart: categoryChart },
                { canvas: document.getElementById("sixMonthChart"), chart: sixMonthChart },
                { canvas: document.getElementById("dailyChart"),    chart: dailyChart },
                { canvas: document.getElementById("weeklyChart"),   chart: weeklyChart }
            ];

            const replacements = [];

            chartMap.forEach(function (entry) {

                if (!entry.canvas || !entry.chart) {
                    return;
                }

                const img = document.createElement("img");

                img.src = entry.chart.toBase64Image("image/png", 1);
                img.style.width = entry.canvas.style.width || "100%";
                img.style.height = entry.canvas.style.height || "320px";
                img.style.display = "block";

                entry.canvas.parentNode.insertBefore(img, entry.canvas);
                entry.canvas.style.display = "none";

                replacements.push({
                    canvas: entry.canvas,
                    img: img
                });

            });

            try {

                const canvas =
                    await html2canvas(
                        report,
                        {
                            scale: 2,
                            backgroundColor: "#ffffff",
                            useCORS: true,
                            logging: false,
                            windowWidth: report.scrollWidth,
                            windowHeight: report.scrollHeight
                        }
                    );

                const link =
                    document.createElement("a");

                link.download =
                    "CampusCoin-Report-@ViewBag.SelectedMonth" + ".png";

                link.href =
                    canvas.toDataURL("image/png");

                link.click();

            } finally {

                replacements.forEach(function (entry) {

                    if (entry.img.parentNode) {
                        entry.img.parentNode.removeChild(entry.img);
                    }

                    entry.canvas.style.display = "";

                });

                if (controls) {
                    controls.style.display = "";
                }

            }
        }

    </script>


    <!-- html2canvas -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>


    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>