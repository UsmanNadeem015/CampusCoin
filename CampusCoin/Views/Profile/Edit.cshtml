@model CampusCoin.Domain.Entities.User

@{
    Layout = null;
    ViewData["Title"] = "Edit Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CampusCoin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }

/* =========================================
   NAVBAR
   ========================================= */

.main-navbar {
    background: #ffffff;
    border-bottom: 1px solid var(--border-color);
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-navy);
    text-decoration: none;
}

.brand-icon {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-navy);
    border: 1px solid var(--brand-gold);
    color: var(--brand-gold-light);
}

.brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1;
}

.brand-name span {
    color: var(--brand-gold);
}

.brand-subtitle {
    display: block;
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
}

.nav-link {
    color: var(--brand-navy) !important;
    font-size: 0.78rem;
    font-weight: 700;
}

.nav-link:hover,
.nav-link.active {
    color: var(--brand-gold) !important;
}

.btn {
    font-weight: 700;
    border-radius: 4px;
    transition: all 0.2s ease;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn-navy {
    background: var(--brand-navy) !important;
    border-color: var(--brand-navy) !important;
    color: #ffffff !important;
}

.btn-navy:hover {
    background: var(--brand-navy-light) !important;
    border-color: var(--brand-navy-light) !important;
}

.btn-outline-navy {
    background: transparent !important;
    border: 1px solid var(--brand-navy) !important;
    color: var(--brand-navy) !important;
}

.btn-outline-navy:hover {
    background: var(--brand-navy) !important;
    color: #ffffff !important;
}
        .page-wrapper {
            max-width: 800px;
            margin: 0 auto;
            padding: 50px 20px 60px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
        }

        .page-header p {
            margin: 8px 0 0;
            color: #64748b;
        }

        .form-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            color: #334155;
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            padding: 12px 14px;
            font-family: inherit;
            color: #0f172a;
            transition: 0.2s ease;
            background: white;
        }

        .form-control:focus {
            border-color: #d97706;
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.12);
            outline: none;
        }

        .form-control[readonly] {
            background: #f1f5f9;
            color: #64748b;
            cursor: not-allowed;
        }

        .field-help {
            margin-top: 6px;
            font-size: 0.78rem;
            color: #94a3b8;
        }

        .text-danger {
            display: block;
            margin-top: 6px;
            font-size: 0.8rem;
            color: #dc2626 !important;
        }

        .validation-summary {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            border-radius: 10px;
            padding: 12px 15px;
            margin-bottom: 22px;
        }

        .button-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 28px;
            padding-top: 25px;
            border-top: 1px solid #e2e8f0;
        }

        .btn-gold {
            background: #d97706;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 11px 18px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .btn-gold:hover {
            background: #b45309;
            transform: translateY(-1px);
        }

        .btn-light-custom {
            background: #f1f5f9;
            color: #334155;
            border-radius: 10px;
            padding: 11px 18px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.2s ease;
        }

        .btn-light-custom:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        footer {
            background: #0f172a;
            color: #94a3b8;
            text-align: center;
            padding: 22px 15px;
            margin-top: 20px;
            font-size: 0.9rem;
        }

        @@media (max-width: 768px) {
            .page-wrapper {
                padding-top: 35px;
            }

            .form-card {
                padding: 22px;
            }

            .navbar-nav .nav-link {
                margin-left: 0;
                margin-top: 5px;
            }
        }
    </style>
</head>

<body>

   <nav class="navbar navbar-expand-lg main-navbar">

    <div class="container-fluid px-4 px-lg-5">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>

                <div class="brand-name">
                    CAMPUS<span>COIN</span>
                </div>

                <span class="brand-subtitle">
                    Smart Student Budgeting
                </span>

            </div>

        </a>


        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#studentNavbar">

            <span class="navbar-toggler-icon"></span>

        </button>


        <div class="collapse navbar-collapse"
             id="studentNavbar">

            <div class="navbar-nav mx-auto">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-link">
                    Dashboard
                </a>

                <a asp-controller="Transactions"
                   asp-action="Index"
                   class="nav-link">
                    Transactions
                </a>

                <a asp-controller="Budgets"
                   asp-action="Index"
                   class="nav-link">
                    Budgets
                </a>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="nav-link">
                    Categories
                </a>

                <a asp-controller="SavingTips"
                   asp-action="Index"
                   class="nav-link">
                    Saving Tips
                </a>

                <a asp-controller="Bookmarks"
                   asp-action="Index"
                   class="nav-link">
                    Bookmarks
                </a>

                <a asp-controller="Notes"
                   asp-action="Index"
                   class="nav-link">
                    Notes
                </a>

            </div>


            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">

                    <i class="fa-solid fa-user me-1"></i>
                    Profile

                </a>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout

                    </button>

                </form>

            </div>

        </div>

    </div>

</nav>

    <!-- Main Content -->
    <main class="page-wrapper">

        <div class="page-header">
            <h1>Edit Profile</h1>
            <p>Update your personal and budgeting information.</p>
        </div>

        <div class="form-card">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="Name"
                           class="form-label">
                        <i class="fa-solid fa-user me-1"></i>
                        Name
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Email"
                           class="form-label">
                        <i class="fa-solid fa-envelope me-1"></i>
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           readonly />

                    <div class="field-help">
                        Your email address cannot be changed here.
                    </div>

                </div>

                <div class="form-group">

                    <label asp-for="AcademicYear"
                           class="form-label">
                        <i class="fa-solid fa-graduation-cap me-1"></i>
                        Academic Year
                    </label>

                    <input asp-for="AcademicYear"
                           class="form-control" />

                    <span asp-validation-for="AcademicYear"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="MonthlyAllowance"
                           class="form-label">
                        <i class="fa-solid fa-wallet me-1"></i>
                        Monthly Allowance
                    </label>

                    <input asp-for="MonthlyAllowance"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />

                    <span asp-validation-for="MonthlyAllowance"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="SavingsGoal"
                           class="form-label">
                        <i class="fa-solid fa-bullseye me-1"></i>
                        Savings Goal
                    </label>

                    <input asp-for="SavingsGoal"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />

                    <span asp-validation-for="SavingsGoal"
                          class="text-danger">
                    </span>

                </div>

                <div class="button-row">

                    <button type="submit"
                            class="btn-gold">
                        <i class="fa-solid fa-check"></i>
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn-light-custom">
                        <i class="fa-solid fa-xmark"></i>
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </main>

    <footer>
        &copy; @DateTime.Now.Year CampusCoin. Student finance made simpler.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>