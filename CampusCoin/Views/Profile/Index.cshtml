@model CampusCoin.Domain.Entities.User

@{
    Layout = null;
    ViewData["Title"] = "My Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CampusCoin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }

      /* =========================================
   NAVBAR
   ========================================= */

.main-navbar {
    background: #ffffff;
    border-bottom: 1px solid var(--border-color);
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-navy);
    text-decoration: none;
}

.brand-icon {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-navy);
    border: 1px solid var(--brand-gold);
    color: var(--brand-gold-light);
}

.brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1;
}

.brand-name span {
    color: var(--brand-gold);
}

.brand-subtitle {
    display: block;
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
}

.nav-link {
    color: var(--brand-navy) !important;
    font-size: 0.78rem;
    font-weight: 700;
}

.nav-link:hover,
.nav-link.active {
    color: var(--brand-gold) !important;
}

.btn {
    font-weight: 700;
    border-radius: 4px;
    transition: all 0.2s ease;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn-navy {
    background: var(--brand-navy) !important;
    border-color: var(--brand-navy) !important;
    color: #ffffff !important;
}

.btn-navy:hover {
    background: var(--brand-navy-light) !important;
    border-color: var(--brand-navy-light) !important;
}

.btn-outline-navy {
    background: transparent !important;
    border: 1px solid var(--brand-navy) !important;
    color: var(--brand-navy) !important;
}

.btn-outline-navy:hover {
    background: var(--brand-navy) !important;
    color: #ffffff !important;
}

        .page-wrapper {
            max-width: 1000px;
            margin: 0 auto;
            padding: 50px 20px 60px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
        }

        .page-header p {
            margin: 8px 0 0;
            color: #64748b;
        }

        .profile-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
        }

        .profile-top {
            background: #0f172a;
            padding: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .profile-avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: #fbbf24;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            font-weight: 800;
            flex-shrink: 0;
        }

        .profile-top h2 {
            color: white;
            margin: 0;
            font-size: 1.4rem;
            font-weight: 800;
        }

        .profile-top p {
            color: #cbd5e1;
            margin: 6px 0 0;
        }

        .profile-body {
            padding: 30px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .info-item {
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 20px;
            background: #f8fafc;
        }

        .info-label {
            color: #64748b;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 8px;
        }

        .info-value {
            color: #0f172a;
            font-size: 1rem;
            font-weight: 700;
        }

        .profile-actions {
            margin-top: 28px;
            padding-top: 25px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-gold {
            background: #d97706;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 11px 18px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.2s ease;
        }

        .btn-gold:hover {
            background: #b45309;
            color: white;
            transform: translateY(-1px);
        }

        .btn-light-custom {
            background: #f1f5f9;
            color: #334155;
            border-radius: 10px;
            padding: 11px 18px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.2s ease;
        }

        .btn-light-custom:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        footer {
            background: #0f172a;
            color: #94a3b8;
            text-align: center;
            padding: 22px 15px;
            margin-top: 20px;
            font-size: 0.9rem;
        }

        @@media (max-width: 768px) {
            .page-wrapper {
                padding-top: 35px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .profile-top {
                padding: 25px;
            }

            .profile-body {
                padding: 22px;
            }

            .navbar-nav .nav-link {
                margin-left: 0;
                margin-top: 5px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg main-navbar">

    <div class="container-fluid px-4 px-lg-5">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>

                <div class="brand-name">
                    CAMPUS<span>COIN</span>
                </div>

                <span class="brand-subtitle">
                    Smart Student Budgeting
                </span>

            </div>

        </a>


        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#studentNavbar">

            <span class="navbar-toggler-icon"></span>

        </button>


        <div class="collapse navbar-collapse"
             id="studentNavbar">

            <div class="navbar-nav mx-auto">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-link">
                    Dashboard
                </a>

                <a asp-controller="Transactions"
                   asp-action="Index"
                   class="nav-link">
                    Transactions
                </a>

                <a asp-controller="Budgets"
                   asp-action="Index"
                   class="nav-link">
                    Budgets
                </a>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="nav-link">
                    Categories
                </a>

                <a asp-controller="SavingTips"
                   asp-action="Index"
                   class="nav-link">
                    Saving Tips
                </a>

                <a asp-controller="Bookmarks"
                   asp-action="Index"
                   class="nav-link">
                    Bookmarks
                </a>

                <a asp-controller="Notes"
                   asp-action="Index"
                   class="nav-link">
                    Notes
                </a>

            </div>


            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">

                    <i class="fa-solid fa-user me-1"></i>
                    Profile

                </a>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout

                    </button>

                </form>

            </div>

        </div>

    </div>

</nav>

    <!-- Main Content -->
    <main class="page-wrapper">

        <div class="page-header">
            <h1>My Profile</h1>
            <p>View and manage your CampusCoin account information.</p>
        </div>

        <div class="profile-card">

            <div class="profile-top">

                <div class="profile-avatar">
                    @(string.IsNullOrWhiteSpace(Model.Name)
                        ? "U"
                        : Model.Name.Substring(0, 1).ToUpper())
                </div>

                <div>
                    <h2>@Model.Name</h2>
                    <p>@Model.Email</p>
                </div>

            </div>

            <div class="profile-body">

                <div class="info-grid">

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fa-solid fa-user me-1"></i>
                            Name
                        </div>

                        <div class="info-value">
                            @Model.Name
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fa-solid fa-envelope me-1"></i>
                            Email
                        </div>

                        <div class="info-value">
                            @Model.Email
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fa-solid fa-graduation-cap me-1"></i>
                            Academic Year
                        </div>

                        <div class="info-value">
                            @(Model.AcademicYear?.ToString() ?? "-")
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fa-solid fa-wallet me-1"></i>
                            Monthly Allowance
                        </div>

                        <div class="info-value">
                            @(Model.MonthlyAllowance.HasValue
                                ? $"Rs. {Model.MonthlyAllowance.Value:N2}"
                                : "-")
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fa-solid fa-bullseye me-1"></i>
                            Savings Goal
                        </div>

                        <div class="info-value">
                            @(Model.SavingsGoal.HasValue
                                ? $"Rs. {Model.SavingsGoal.Value:N2}"
                                : "-")
                        </div>
                    </div>

                </div>

                <div class="profile-actions">

                    <a asp-action="Edit"
                       class="btn-gold">
                        <i class="fa-solid fa-pen"></i>
                        Edit Profile
                    </a>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn-light-custom">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Dashboard
                    </a>

                </div>

            </div>

        </div>

    </main>

    <footer>
        &copy; @DateTime.Now.Year CampusCoin. Student finance made simpler.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>