@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Campus Coin - Access Denied</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }

        .fa-solid {
            font-family: "Font Awesome 6 Free" !important;
            font-weight: 900 !important;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
            background:
                linear-gradient(
                    135deg,
                    #f8fafc 0%,
                    #eef2f7 100%
                );
        }

        .card {
            width: 100%;
            max-width: 560px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            padding: 45px;
            text-align: center;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
            font-weight: 800;
            font-size: 1.15rem;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand span {
            color: var(--brand-gold);
        }

        .icon-box {
            width: 80px;
            height: 80px;
            margin: 40px auto 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: var(--brand-gold);
            font-size: 2rem;
        }

        h1 {
            color: var(--brand-navy);
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 12px;
        }

        p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 25px;
        }

        .btn-home {
            display: inline-block;
            padding: 12px 22px;
            background: var(--brand-gold);
            border: 1px solid var(--brand-gold);
            color: #ffffff;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .btn-home:hover {
            background: var(--brand-gold-hover);
            border-color: var(--brand-gold-hover);
            color: #ffffff;
        }

        .back-link {
            display: block;
            margin-top: 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.78rem;
        }

        .back-link:hover {
            color: var(--brand-gold);
        }

        @@media (max-width: 576px) {

            .page {
                padding: 15px;
            }

            .card {
                padding: 30px 22px;
            }

        }

    </style>

</head>

<body>

    <main class="page">

        <div class="card">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                CAMPUS<span>COIN</span>

            </a>


            <div class="icon-box">

                <i class="fa-solid fa-shield-halved"></i>

            </div>


            <h1>
                Access Denied
            </h1>


            <p>
                You do not have permission to access this page.
                Please return to a page available to your account.
            </p>


            <a asp-controller="Home"
               asp-action="Index"
               class="btn-home">

                <i class="fa-solid fa-house me-2"></i>

                Return to Home

            </a>


            <a asp-controller="Account"
               asp-action="Login"
               class="back-link">

                <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>

                Go to Login

            </a>

        </div>

    </main>

</body>

</html>