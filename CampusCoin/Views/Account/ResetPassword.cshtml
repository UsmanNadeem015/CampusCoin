@model CampusCoin.Controllers.AccountController.ResetPasswordInput

@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Campus Coin - Reset Password</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }

        .fa-solid {
            font-family: "Font Awesome 6 Free" !important;
            font-weight: 900 !important;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
            background:
                linear-gradient(
                    135deg,
                    #f8fafc 0%,
                    #eef2f7 100%
                );
        }

        .card {
            width: 100%;
            max-width: 500px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            padding: 45px;
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
            font-size: 1.15rem;
            font-weight: 800;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand span {
            color: var(--brand-gold);
        }

        .header {
            text-align: center;
            margin: 35px 0;
        }

        .header-icon {
            width: 58px;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: var(--brand-gold);
            font-size: 1.35rem;
        }

        .header h1 {
            color: var(--brand-navy);
            font-size: 1.65rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .header p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 0;
        }

        .validation-summary {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            padding: 12px 14px;
            font-size: 0.78rem;
            margin-bottom: 20px;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 0;
            list-style: none;
        }

        .validation-summary li {
            margin: 0;
        }

        .validation-summary li:not(:last-child) {
            margin-bottom: 4px;
        }

        .form-label {
            color: var(--brand-navy);
            font-size: 0.75rem;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .form-control {
            min-height: 46px;
            border: 1px solid #cbd5e1;
            border-radius: 0;
            font-size: 0.85rem;
            box-shadow: none !important;
        }

        .form-control:focus {
            border-color: var(--brand-gold);
            box-shadow:
                0 0 0 3px rgba(217,119,6,0.12) !important;
        }

        .validation {
            display: block;
            color: #dc2626;
            font-size: 0.72rem;
            margin-top: 5px;
        }

        .submit-btn {
            width: 100%;
            min-height: 48px;
            background: var(--brand-gold);
            border: 1px solid var(--brand-gold);
            color: #ffffff;
            font-weight: 700;
        }

        .submit-btn:hover {
            background: var(--brand-gold-hover);
            border-color: var(--brand-gold-hover);
            color: #ffffff;
        }

        .security-note {
            margin-top: 18px;
            padding: 12px 14px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.72rem;
        }

        .links {
            text-align: center;
            margin-top: 25px;
        }

        .links a {
            color: var(--brand-gold);
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .links a:hover {
            color: var(--brand-gold-hover);
        }

        @@media (max-width: 576px) {

            .page {
                padding: 15px;
            }

            .card {
                padding: 30px 22px;
            }

        }

    </style>

</head>

<body>

    <main class="page">

        <div class="card">


            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">

                    <i class="fa-solid fa-coins"></i>

                </div>

                CAMPUS<span>COIN</span>

            </a>


            <div class="header">

                <div class="header-icon">

                    <i class="fa-solid fa-lock"></i>

                </div>

                <h1>
                    Reset Password
                </h1>

                <p>
                    Choose a new password for your Campus Coin account.
                </p>

            </div>


            <form asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()


                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All"
                         class="validation-summary">
                    </div>
                }


                <input asp-for="Token"
                       type="hidden" />


                <div class="mb-3">

                    <label asp-for="NewPassword"
                           class="form-label">

                        New Password

                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control"
                           placeholder="Enter new password"
                           required />

                    <span asp-validation-for="NewPassword"
                          class="validation">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label">

                        Confirm New Password

                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm new password"
                           required />

                    <span asp-validation-for="ConfirmPassword"
                          class="validation">
                    </span>

                </div>


                <button type="submit"
                        class="btn submit-btn">

                    <i class="fa-solid fa-key me-2"></i>

                    Reset Password

                </button>


                <div class="security-note">

                    <i class="fa-solid fa-shield-halved me-1"></i>

                    Your reset link is temporary and expires after
                    the configured reset period.

                </div>

            </form>


            <div class="links">

                <a asp-controller="Account"
                   asp-action="Login">

                    <i class="fa-solid fa-arrow-left me-1"></i>

                    Back to Login

                </a>

            </div>


            <div class="links mt-3">

                <a asp-controller="Home"
                   asp-action="Index">

                    Return to Home

                </a>

            </div>

        </div>

    </main>


    <partial name="_ValidationScriptsPartial" />

</body>

</html>