@model IEnumerable<CampusCoin.Domain.Entities.User>

@{
    ViewData["Title"] = "Manage Users";
    Layout = null;
    var users = Model.ToList();
    var totalUsers = users.Count;
    var activeUsers = users.Count(u => u.IsActive);
    var disabledUsers = users.Count(u => !u.IsActive);
    var adminUsers = users.Count(u => u.IsAdmin);
    var studentUsers = users.Count(u => !u.IsAdmin);
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Manage Users</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .admin-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 12px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
        }

        .admin-user-icon {
            color: var(--brand-gold);
        }

        .admin-user-name {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--brand-navy);
        }

        .admin-user-role {
            display: block;
            color: var(--text-muted);
            font-size: 0.65rem;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-danger {
            background: #dc2626 !important;
            border-color: #dc2626 !important;
            color: #ffffff !important;
        }

        .btn-danger:hover {
            background: #b91c1c !important;
            border-color: #b91c1c !important;
        }

        .btn-success {
            background: #16a34a !important;
            border-color: #16a34a !important;
            color: #ffffff !important;
        }

        .btn-success:hover {
            background: #15803d !important;
            border-color: #15803d !important;
        }


        .page-header {
            background-color: var(--brand-navy);
            background-image: linear-gradient(rgba(15, 23, 42, 0.78), rgba(15, 23, 42, 0.85)), url('/images/banners/admin-banner.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            color: #ffffff;
            padding: 40px 0;
            border-bottom: 1px solid #334155;
        }

        .page-header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .admin-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: var(--brand-gold-light);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .page-content {
            flex: 1;
            padding: 45px 0 60px;
        }

        .summary-card {
            height: 100%;
            padding: 20px;
            background: #ffffff;
            border: 1px solid var(--border-color);
        }

        .summary-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 1rem;
        }

        .summary-label {
            display: block;
            margin-bottom: 4px;
            color: var(--text-muted);
            font-size: 0.69rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .summary-value {
            margin: 0;
            color: var(--brand-navy);
            font-size: 1.6rem;
            font-weight: 800;
        }

        .user-panel {
            background: #ffffff;
            border: 1px solid var(--border-color);
        }

        .panel-header {
            padding: 22px;
            border-bottom: 1px solid var(--border-color);
        }

        .panel-title {
            margin: 0;
            color: var(--brand-navy);
            font-size: 1rem;
            font-weight: 800;
        }

        .panel-subtitle {
            margin: 5px 0 0;
            color: var(--text-muted);
            font-size: 0.76rem;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .user-table {
            margin: 0;
        }

        .user-table thead th {
            padding: 14px 18px;
            background: #f8fafc;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.67rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

        .user-table tbody td {
            padding: 16px 18px;
            border-bottom: 1px solid var(--border-color);
            color: var(--brand-navy);
            font-size: 0.79rem;
            vertical-align: middle;
        }

        .user-table tbody tr:last-child td {
            border-bottom: none;
        }

        .user-table tbody tr:hover {
            background: #f8fafc;
        }

        .user-id {
            color: var(--text-muted);
            font-size: 0.72rem;
            font-weight: 600;
        }

        .user-name {
            font-weight: 700;
        }

        .user-email {
            color: var(--text-muted);
        }

        .role-badge,
        .status-badge {
            display: inline-block;
            padding: 5px 9px;
            font-size: 0.67rem;
            font-weight: 700;
        }

        .role-admin {
            background: #fef3c7;
            border: 1px solid #fde68a;
            color: #92400e;
        }

        .role-student {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1d4ed8;
        }

        .status-active {
            background: #ecfdf5;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        .status-disabled {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .action-form {
            margin: 0;
        }

        .empty-state {
            padding: 55px 20px;
            text-align: center;
            color: var(--text-muted);
        }

        .empty-state i {
            margin-bottom: 12px;
            color: var(--brand-gold);
            font-size: 2rem;
        }

        .empty-state h3 {
            margin-bottom: 6px;
            color: var(--brand-navy);
            font-size: 1rem;
            font-weight: 800;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.78rem;
        }

        .alert {
            border-radius: 4px;
            font-size: 0.8rem;
        }

        footer {
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }

        @@media (max-width: 768px) {

            .admin-user {
                display: none;
            }

            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.5rem;
            }

            .user-table thead th,
            .user-table tbody td {
                padding: 12px;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar admin-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Administration
                    </span>

                </div>

            </a>

            <div class="d-flex align-items-center gap-2">

                <div class="admin-user">

                    <i class="fa-solid fa-user-shield admin-user-icon"></i>

                    <div>

                        <span class="admin-user-name">
                            @(User.Identity?.Name ?? "Administrator")
                        </span>

                        <span class="admin-user-role">
                            Administrator
                        </span>

                    </div>

                </div>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">

                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Dashboard

                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1 text-warning"></i>
                        Logout

                    </button>

                </form>

            </div>

        </div>

    </nav>

    <header class="page-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="admin-badge">

                <i class="fa-solid fa-users me-1"></i>
                User Management

            </span>

            <h1 class="mt-3">
                Manage Users
            </h1>

            <p>
                View CampusCoin accounts and manage their activation status.
            </p>

        </div>

    </header>

    <main class="page-content">

        <div class="container-fluid px-4 px-lg-5">


            <!-- ALERTS -->

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mb-4">

                    <i class="fa-solid fa-circle-check me-2"></i>

                    @TempData["Success"]

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-4">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>

                    @TempData["Error"]

                </div>
            }

            <div class="row g-4 mb-4">

                <div class="col-lg-3 col-md-6">

                    <div class="summary-card">

                        <div class="d-flex align-items-center gap-3">

                            <div class="summary-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>

                            <div>

                                <span class="summary-label">
                                    Total Users
                                </span>

                                <h2 class="summary-value">
                                    @totalUsers
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-3 col-md-6">

                    <div class="summary-card">

                        <div class="d-flex align-items-center gap-3">

                            <div class="summary-icon">
                                <i class="fa-solid fa-user-check"></i>
                            </div>

                            <div>

                                <span class="summary-label">
                                    Active Users
                                </span>

                                <h2 class="summary-value">
                                    @activeUsers
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-3 col-md-6">

                    <div class="summary-card">

                        <div class="d-flex align-items-center gap-3">

                            <div class="summary-icon">
                                <i class="fa-solid fa-user-slash"></i>
                            </div>

                            <div>

                                <span class="summary-label">
                                    Disabled Users
                                </span>

                                <h2 class="summary-value">
                                    @disabledUsers
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-3 col-md-6">

                    <div class="summary-card">

                        <div class="d-flex align-items-center gap-3">

                            <div class="summary-icon">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>

                            <div>

                                <span class="summary-label">
                                    Students
                                </span>

                                <h2 class="summary-value">
                                    @studentUsers
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="user-panel">

                <div class="panel-header">

                    <h2 class="panel-title">
                        User Accounts
                    </h2>

                    <p class="panel-subtitle">
                        Enable or disable accounts from the action column.
                    </p>

                </div>


                @if (users.Any())
                {
                    <div class="table-wrapper">

                        <table class="table user-table">

                            <thead>

                                <tr>

                                    <th>ID</th>

                                    <th>Name</th>

                                    <th>Email</th>

                                    <th>Academic Year</th>

                                    <th>Role</th>

                                    <th>Status</th>

                                    <th>Action</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var user in users)
                                {
                                    <tr>

                                        <td>
                                            <span class="user-id">
                                                #@user.UserId
                                            </span>
                                        </td>

                                        <td>
                                            <span class="user-name">
                                                @user.Name
                                            </span>
                                        </td>

                                        <td>
                                            <span class="user-email">
                                                @user.Email
                                            </span>
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(user.AcademicYear)
                                                ? "—"
                                                : user.AcademicYear)
                                        </td>

                                        <td>

                                            @if (user.IsAdmin)
                                            {
                                                <span class="role-badge role-admin">
                                                    <i class="fa-solid fa-shield-halved me-1"></i>
                                                    Admin
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="role-badge role-student">
                                                    <i class="fa-solid fa-user me-1"></i>
                                                    Student
                                                </span>
                                            }

                                        </td>

                                        <td>

                                            @if (user.IsActive)
                                            {
                                                <span class="status-badge status-active">
                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-disabled">
                                                    <i class="fa-solid fa-ban me-1"></i>
                                                    Disabled
                                                </span>
                                            }

                                        </td>

                                        <td>

                                            <form asp-controller="Admin"
                                                  asp-action="ToggleUserStatus"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.UserId" />

                                                @if (user.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm">

                                                        <i class="fa-solid fa-user-slash me-1"></i>
                                                        Disable

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">

                                                        <i class="fa-solid fa-user-check me-1"></i>
                                                        Enable

                                                    </button>
                                                }

                                            </form>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <i class="fa-solid fa-users-slash"></i>

                        <h3>
                            No Users Found
                        </h3>

                        <p>
                            There are currently no accounts in CampusCoin.
                        </p>

                    </div>
                }

            </div>

        </div>

    </main>

    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin Administration</strong>
                    · Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>