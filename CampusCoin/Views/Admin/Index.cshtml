@{
    Layout = null;
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Campus Coin - Admin Dashboard
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family:
        'Plus Jakarta Sans',
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        sans-serif;
    background: #f8fafc;
    color: #0f172a;
}

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }


        /* =========================================
           NAVBAR
           ========================================= */

        .admin-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 12px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
        }

        .admin-user-icon {
            color: var(--brand-gold);
        }

        .admin-user-name {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--brand-navy);
        }

        .admin-user-role {
            display: block;
            color: var(--text-muted);
            font-size: 0.65rem;
        }


        /* =========================================
           BUTTONS
           ========================================= */

        .btn {
            font-weight: 700;
            transition: all 0.2s ease;
            border-radius: 4px;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-gold {
            background: var(--brand-gold) !important;
            border-color: var(--brand-gold) !important;
            color: #ffffff !important;
        }

        .btn-gold:hover {
            background: var(--brand-gold-hover) !important;
            border-color: var(--brand-gold-hover) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }


        /* =========================================
           PAGE HEADER
           ========================================= */

        .page-header {
            background: var(--brand-navy);
            color: #ffffff;
            padding: 42px 0;
            border-bottom: 1px solid #334155;
        }

        .page-header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #94a3b8;
            margin: 0;
            font-size: 0.85rem;
        }

        .admin-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: var(--brand-gold-light);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }


        /* =========================================
           MAIN CONTENT
           ========================================= */

       .dashboard-content {
    padding: 50px 0;
    flex: 1;
}

        /* =========================================
   STATISTICS CARDS
   ========================================= */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 50px;
}

.stat-card {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 115px;
    padding: 22px;
    background: #ffffff;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
    border-color: var(--brand-gold);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
}

.stat-icon {
    width: 50px;
    height: 50px;
    min-width: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-navy);
    color: var(--brand-gold-light);
    font-size: 1.1rem;
}

.stat-label {
    display: block;
    margin-bottom: 5px;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.stat-value {
    margin: 0;
    color: var(--brand-navy);
    font-size: 1.65rem;
    font-weight: 800;
    line-height: 1;
}

.stat-description {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 0.7rem;
}

/* Responsive */

@@media (max-width: 1100px) {

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@@media (max-width: 576px) {

    .stats-grid {
        grid-template-columns: 1fr;
    }

}

        .section-heading h2 {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--brand-navy);
            margin-bottom: 7px;
        }

        .section-heading p {
            color: var(--text-muted);
            font-size: 0.82rem;
            margin-bottom: 30px;
        }


        /* =========================================
           ADMIN MODULE CARDS
           ========================================= */

           .modules-grid {
    margin-bottom: 55px;
}
        .module-card {
            height: 100%;
            padding: 28px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            transition:
                transform 0.2s ease,
                border-color 0.2s ease;
        }

        .module-card:hover {
            transform: translateY(-3px);
            border-color: var(--brand-gold);
            color: inherit;
        }

        .module-icon {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

        .module-card h3 {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--brand-navy);
            margin-bottom: 8px;
        }

        .module-card p {
            color: var(--text-muted);
            font-size: 0.82rem;
            line-height: 1.6;
            margin-bottom: 20px;
            flex-grow: 1;
        }

        .module-link {
            color: var(--brand-gold);
            font-size: 0.78rem;
            font-weight: 800;
        }


        /* =========================================
           FOOTER
           ========================================= */

        footer {
            margin-top: auto;
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }


        /* =========================================
           RESPONSIVE
           ========================================= */

        @@media (max-width: 768px) {

            .admin-user {
                display: none;
            }

            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.5rem;
            }

        }

    </style>

</head>


<body>


    <!-- =========================================
         NAVBAR
         ========================================= -->

    <nav class="navbar admin-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Admin"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">

                    <i class="fa-solid fa-coins"></i>

                </div>

                <div>

                    <div class="brand-name">

                        CAMPUS<span>COIN</span>

                    </div>

                    <span class="brand-subtitle">

                        Administration

                    </span>

                </div>

            </a>


            <div class="d-flex align-items-center gap-2">

                <div class="admin-user">

                    <i class="fa-solid fa-user-shield admin-user-icon"></i>

                    <div>

                        <span class="admin-user-name">

                            @(User.Identity?.Name ?? "Administrator")

                        </span>

                        <span class="admin-user-role">

                            Administrator

                        </span>

                    </div>

                </div>


                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">

                    <i class="fa-solid fa-house me-1"></i>

                    Home

                </a>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1 text-warning"></i>

                        Logout

                    </button>

                </form>

            </div>

        </div>

    </nav>


    <!-- =========================================
         HEADER
         ========================================= -->

    <header class="page-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="admin-badge">

                <i class="fa-solid fa-shield-halved me-1"></i>

                Admin Console

            </span>

            <h1 class="mt-3">

                Welcome, @(User.Identity?.Name ?? "Administrator")

            </h1>

            <p>

                Manage Campus Coin's users, default categories,
                saving-tip templates and system statistics.

            </p>

        </div>

    </header>


    <!-- =========================================
         MAIN
         ========================================= -->

    <main class="dashboard-content">

        <div class="container-fluid px-4 px-lg-5">


            <!-- MODULES -->

            <div class="section-heading">

                <h2>
                    Administration Modules
                </h2>

                <p>
                    Select a module to manage the corresponding Campus Coin data.
                </p>

            </div>


           <div class="row g-4 modules-grid">

    <!-- USERS -->
    <div class="col-lg-4 col-md-6">

        <a asp-controller="Admin"
           asp-action="Users"
           class="module-card">

            <div class="module-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <h3>User Accounts</h3>

            <p>
                View student accounts and manage
                account activation status.
            </p>

            <span class="module-link">
                Manage Users
                <i class="fa-solid fa-arrow-right ms-1"></i>
            </span>

        </a>

    </div>


    <!-- CATEGORIES -->
    <div class="col-lg-4 col-md-6">

        <a asp-controller="Admin"
           asp-action="Categories"
           class="module-card">

            <div class="module-icon">
                <i class="fa-solid fa-tags"></i>
            </div>

            <h3>Default Categories</h3>

            <p>
                Add, edit or remove the default
                income and expense categories.
            </p>

            <span class="module-link">
                Manage Categories
                <i class="fa-solid fa-arrow-right ms-1"></i>
            </span>

        </a>

    </div>


    <!-- TIP TEMPLATES -->
    <div class="col-lg-4 col-md-6">

        <a asp-controller="Admin"
           asp-action="TipTemplates"
           class="module-card">

            <div class="module-icon">
                <i class="fa-solid fa-lightbulb"></i>
            </div>

            <h3>Tip Templates</h3>

            <p>
                Manage system-wide saving-tip
                templates used by CampusCoin.
            </p>

            <span class="module-link">
                Manage Tip Templates
                <i class="fa-solid fa-arrow-right ms-1"></i>
            </span>

        </a>

    </div>

</div>

<!-- STATISTICS -->

<div class="col-lg-4 col-md-6">

    <a asp-controller="Admin"
       asp-action="Statistics"
       class="module-card">

        <div class="module-icon">
            <i class="fa-solid fa-chart-column"></i>
        </div>

        <h3>
            Usage Statistics
        </h3>

        <p>
            View active users, transaction totals and
            the most-used categories across CampusCoin.
        </p>

        <span class="module-link">

            View Statistics

            <i class="fa-solid fa-arrow-right ms-1"></i>

        </span>

    </a>

</div>

<!-- STATISTICS -->

<div class="section-heading">

    <h2>
        System Overview
    </h2>

    <p>
        Current Campus Coin statistics and system usage.
    </p>

</div>


<div class="stats-grid">

    <!-- USERS -->

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-users"></i>
        </div>

        <div>

            <span class="stat-label">
                Total Users
            </span>

            <h2 class="stat-value">
                @ViewBag.TotalUsers
            </h2>

        </div>

    </div>


    <!-- ACTIVE USERS -->

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-user-check"></i>
        </div>

        <div>

            <span class="stat-label">
                Active Users
            </span>

            <h2 class="stat-value">
                @ViewBag.ActiveUsers
            </h2>

        </div>

    </div>


    <!-- CATEGORIES -->

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-tags"></i>
        </div>

        <div>

            <span class="stat-label">
                Categories
            </span>

            <h2 class="stat-value">
                @ViewBag.TotalCategories
            </h2>

        </div>

    </div>


    <!-- TRANSACTIONS -->

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-receipt"></i>
        </div>

        <div>

            <span class="stat-label">
                Transactions
            </span>

            <h2 class="stat-value">
                @ViewBag.TotalTransactions
            </h2>

        </div>

    </div>


    <!-- BUDGETS -->

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-wallet"></i>
        </div>

        <div>

            <span class="stat-label">
                Budgets
            </span>

            <h2 class="stat-value">
                @ViewBag.TotalBudgets
            </h2>

        </div>

    </div>




    <!-- SAVING TIPS -->

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-piggy-bank"></i>
        </div>

        <div>

            <span class="stat-label">
                Saving Tips
            </span>

            <h2 class="stat-value">
                @ViewBag.TotalSavingTips
            </h2>

        </div>

    </div>


    <!-- TIP TEMPLATES -->

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-lightbulb"></i>
        </div>

        <div>

            <span class="stat-label">
                Tip Templates
            </span>

            <h2 class="stat-value">
                @ViewBag.TotalTipTemplates
            </h2>

        </div>

    </div>

</div>


<!-- MOST USED CATEGORY -->

<div class="section-heading">

    <h2>
        Most Used Category
    </h2>

    <p>
        Category with the highest number of recorded transactions.
    </p>

</div>


<div class="stat-card">

    <div class="stat-icon">
        <i class="fa-solid fa-star"></i>
    </div>

    <div>

        <span class="stat-label">
            Most Used Category
        </span>

        <h2 class="stat-value">
            @ViewBag.MostUsedCategory
        </h2>

        <div class="stat-description">
            @ViewBag.MostUsedCategoryCount transactions
        </div>

    </div>

</div>


<!-- CLOSE DASHBOARD CONTAINER -->
</div>

<!-- CLOSE MAIN -->
</main>


<!-- =========================================
     FOOTER
     ========================================= -->

<footer>

    <div class="container-fluid px-4 px-lg-5">

        <div class="d-flex
                    flex-column
                    flex-md-row
                    justify-content-between
                    gap-2">

            <p>
                <strong>CampusCoin Administration</strong>
                · Student Budgeting Platform
            </p>

            <p>
                © 2026 Campus Coin
            </p>

        </div>

    </div>

</footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>