@{
Layout = null;
    ViewData["Title"] = "Usage Statistics";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Usage Statistics</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .admin-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 12px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
        }

        .admin-user-icon {
            color: var(--brand-gold);
        }

        .admin-user-name {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--brand-navy);
        }

        .admin-user-role {
            display: block;
            color: var(--text-muted);
            font-size: 0.65rem;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .page-header {
            background: var(--brand-navy);
            color: #ffffff;
            padding: 40px 0;
            border-bottom: 1px solid #334155;
        }

        .page-header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .admin-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: var(--brand-gold-light);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .page-content {
            flex: 1;
            padding: 45px 0 60px;
        }

        .stat-card {
            height: 100%;
            padding: 24px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            transition:
                transform 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            border-color: var(--brand-gold);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.07);
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 1.1rem;
            margin-bottom: 18px;
        }

        .stat-label {
            display: block;
            margin-bottom: 5px;
            color: var(--text-muted);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .stat-value {
            margin: 0;
            color: var(--brand-navy);
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
        }

       .section-title {
            margin-bottom: 7px;
            color: var(--brand-navy);
            font-size: 1.2rem;
            font-weight: 800;
        }

        .section-description {
            margin-bottom: 24px;
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        .category-panel {
            background: #ffffff;
            border: 1px solid var(--border-color);
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .category-table {
            margin: 0;
        }

        .category-table thead th {
            padding: 15px 18px;
            background: #f8fafc;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .category-table tbody td {
            padding: 16px 18px;
            border-bottom: 1px solid var(--border-color);
            color: var(--brand-navy);
            font-size: 0.8rem;
            vertical-align: middle;
        }

        .category-table tbody tr:last-child td {
            border-bottom: none;
        }

        .category-table tbody tr:hover {
            background: #f8fafc;
        }

        .rank-badge {
            display: inline-flex;
            width: 30px;
            height: 30px;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 0.72rem;
            font-weight: 800;
        }

        .category-name {
            font-weight: 700;
        }

        .transaction-count {
            font-weight: 800;
            color: var(--brand-gold);
        }

        .empty-state {
            padding: 55px 20px;
            text-align: center;
            color: var(--text-muted);
        }

        .empty-state i {
            margin-bottom: 12px;
            color: var(--brand-gold);
            font-size: 2rem;
        }

        .empty-state h3 {
            margin-bottom: 6px;
            color: var(--brand-navy);
            font-size: 1rem;
            font-weight: 800;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.78rem;
        }

        footer {
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }

        @@media (max-width: 768px) {

            .admin-user {
                display: none;
            }

            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.5rem;
            }

            .stat-card {
                padding: 20px;
            }

            .category-table thead th,
            .category-table tbody td {
                padding: 12px;
            }

        }

    </style>

</head>


<body>

    <nav class="navbar admin-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Administration
                    </span>

                </div>

            </a>


            <div class="d-flex align-items-center gap-2">

                <div class="admin-user">

                    <i class="fa-solid fa-user-shield admin-user-icon"></i>

                    <div>

                        <span class="admin-user-name">
                            @(User.Identity?.Name ?? "Administrator")
                        </span>

                        <span class="admin-user-role">
                            Administrator
                        </span>

                    </div>

                </div>


                <a asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">

                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Dashboard

                </a>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1 text-warning"></i>
                        Logout

                    </button>

                </form>

            </div>

        </div>

    </nav>

    <header class="page-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="admin-badge">

                <i class="fa-solid fa-chart-column me-1"></i>
                Administration

            </span>

            <h1 class="mt-3">
                Usage Statistics
            </h1>

            <p>
                Monitor current CampusCoin usage across users,
                transactions and categories.
            </p>

        </div>

    </header>

    <main class="page-content">

        <div class="container-fluid px-4 px-lg-5">

            <div class="row g-4 mb-5">

                <div class="col-lg-4">

                    <div class="stat-card">

                        <div class="stat-icon">
                            <i class="fa-solid fa-user-check"></i>
                        </div>

                        <span class="stat-label">
                            Active Users
                        </span>

                        <h2 class="stat-value">
                            @ViewBag.ActiveUsers
                        </h2>

                    </div>

                </div>


                <div class="col-lg-4">

                    <div class="stat-card">

                        <div class="stat-icon">
                            <i class="fa-solid fa-receipt"></i>
                        </div>

                        <span class="stat-label">
                            Total Transactions
                        </span>

                        <h2 class="stat-value">
                            @ViewBag.TotalTransactions
                        </h2>

                    </div>

                </div>

                            <div class="col-lg-4">

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fa-solid fa-coins"></i>
        </div>

        <span class="stat-label">
            Total Amount Transacted
        </span>

        <h2 class="stat-value">
            Rs. @(((decimal)ViewBag.TotalTransactionAmount).ToString("N0"))
        </h2>

    </div>

</div>
            </div>



            <h2 class="section-title">
                Most Used Categories
            </h2>

            <p class="section-description">
                Categories ranked by the number of recorded transactions.
            </p>


            <div class="category-panel">

                @if (ViewBag.MostUsedCategories.Count == 0)
                {
                    <div class="empty-state">

                        <i class="fa-solid fa-chart-column"></i>

                        <h3>
                            No Transaction Data
                        </h3>

                        <p>
                            There are no transactions available to generate
                            category usage statistics yet.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-wrapper">

                        <table class="table category-table">

                            <thead>

                                <tr>

                                    <th>
                                        Rank
                                    </th>

                                    <th>
                                        Category
                                    </th>

                                    <th>
                                        Transactions
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @{
                                    int rank = 1;
                                }

                                @foreach (var category in ViewBag.MostUsedCategories)
                                {
                                    <tr>

                                        <td>
                                            <span class="rank-badge">
                                                @rank
                                            </span>
                                        </td>

                                        <td>
                                            <span class="category-name">
                                                @category.CategoryName
                                            </span>
                                        </td>

                                        <td>
                                            <span class="transaction-count">
                                                @category.TransactionCount
                                            </span>
                                        </td>

                                    </tr>

                                    rank++;
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </main>

    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin Administration</strong>
                    · Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>