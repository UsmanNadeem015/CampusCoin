@model CampusCoin.Controllers.AdminController.CategoryInput

@{
    Layout = null;
    ViewData["Title"] = "Edit Category";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Edit Category</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .admin-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 12px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
        }

        .admin-user-icon {
            color: var(--brand-gold);
        }

        .admin-user-name {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--brand-navy);
        }

        .admin-user-role {
            display: block;
            color: var(--text-muted);
            font-size: 0.65rem;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-gold {
            background: var(--brand-gold) !important;
            border-color: var(--brand-gold) !important;
            color: #ffffff !important;
        }

        .btn-gold:hover {
            background: var(--brand-gold-hover) !important;
            border-color: var(--brand-gold-hover) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .page-header {
            background: var(--brand-navy);
            color: #ffffff;
            padding: 40px 0;
            border-bottom: 1px solid #334155;
        }

        .page-header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .admin-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: var(--brand-gold-light);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .page-content {
            flex: 1;
            padding: 50px 0 60px;
        }

        .form-card {
            max-width: 760px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid var(--border-color);
            padding: 32px;
        }

        .form-icon {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 1.15rem;
            margin-bottom: 18px;
        }

        .form-title {
            margin: 0;
            color: var(--brand-navy);
            font-size: 1.25rem;
            font-weight: 800;
        }

        .form-description {
            margin: 7px 0 28px;
            color: var(--text-muted);
            font-size: 0.8rem;
            line-height: 1.6;
        }

        .form-label {
            margin-bottom: 7px;
            color: var(--brand-navy);
            font-size: 0.76rem;
            font-weight: 700;
        }

        .form-control,
        .form-select {
            min-height: 46px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            font-size: 0.82rem;
            box-shadow: none;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--brand-gold);
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.1);
        }

        .validation-summary {
            margin-bottom: 22px;
            padding: 14px 16px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            font-size: 0.78rem;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
            color: #dc2626;
            font-size: 0.7rem;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 30px;
            padding-top: 22px;
            border-top: 1px solid var(--border-color);
        }

        footer {
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }

        @@media (max-width: 768px) {

            .admin-user {
                display: none;
            }

            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.5rem;
            }

            .form-card {
                padding: 24px;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .form-actions .btn {
                width: 100%;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar admin-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Admin"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Administration
                    </span>

                </div>

            </a>

            <div class="d-flex align-items-center gap-2">

                <div class="admin-user">

                    <i class="fa-solid fa-user-shield admin-user-icon"></i>

                    <div>

                        <span class="admin-user-name">
                            @(User.Identity?.Name ?? "Administrator")
                        </span>

                        <span class="admin-user-role">
                            Administrator
                        </span>

                    </div>

                </div>

                <a asp-controller="Admin"
                   asp-action="Categories"
                   class="btn btn-outline-navy btn-sm">

                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Categories

                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1 text-warning"></i>
                        Logout

                    </button>

                </form>

            </div>

        </div>

    </nav>


    <header class="page-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="admin-badge">

                <i class="fa-solid fa-pen-to-square me-1"></i>
                Category Management

            </span>

            <h1 class="mt-3">
                Edit Default Category
            </h1>

            <p>
                Update the name or type of this system-wide category.
            </p>

        </div>

    </header>


    <main class="page-content">

        <div class="container-fluid px-4 px-lg-5">

            <div class="form-card">

                <div class="form-icon">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>

                <h2 class="form-title">
                    Edit Category
                </h2>

                <p class="form-description">
                    Make your changes below and save them to update the
                    default category.
                </p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">

                        <strong>
                            Please correct the following:
                        </strong>

                        <div class="mt-2">
                            <div asp-validation-summary="All"></div>
                        </div>

                    </div>
                }

                <form asp-controller="Admin"
                      asp-action="EditCategory"
                      asp-route-id="@ViewBag.CategoryId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-4">

                        <label asp-for="Name"
                               class="form-label">
                            Category Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Books & Stationery" />

                        <span asp-validation-for="Name"
                              class="field-validation-error">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Type"
                               class="form-label">
                            Category Type
                        </label>

                        <select asp-for="Type"
                                asp-items="Html.GetEnumSelectList<CampusCoin.Domain.Enums.CategoryType>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Type"
                              class="field-validation-error">
                        </span>

                    </div>


                    <div class="form-actions">

                        <a asp-controller="Admin"
                           asp-action="Categories"
                           class="btn btn-outline-navy">

                            <i class="fa-solid fa-xmark me-1"></i>
                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-gold">

                            <i class="fa-solid fa-floppy-disk me-1"></i>
                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>


    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin Administration</strong>
                    · Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>