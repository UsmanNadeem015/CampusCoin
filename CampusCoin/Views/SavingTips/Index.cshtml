@model List<CampusCoin.Domain.Entities.SavingTip>

@using CampusCoin.Domain.Entities

@{
    Layout = null;
    ViewData["Title"] = "Saving Tips";

    var tipTemplates =
        ViewBag.TipTemplates as List<TipTemplate>
        ?? new List<TipTemplate>();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Saving Tips</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --success: #16a34a;
            --danger: #dc2626;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .main-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .nav-link {
            color: var(--brand-navy) !important;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .nav-link:hover
        .nav-link.active{
            color: var(--brand-gold) !important;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-gold {
            background: var(--brand-gold) !important;
            border-color: var(--brand-gold) !important;
            color: #ffffff !important;
        }

        .btn-gold:hover {
            background: var(--brand-gold-hover) !important;
            border-color: var(--brand-gold-hover) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .page-header {
            background: var(--brand-navy);
            color: #ffffff;
            padding: 42px 0;
            border-bottom: 1px solid #334155;
        }

        .page-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: var(--brand-gold-light);
            font-size: 0.67rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .page-header h1 {
            margin: 14px 0 8px;
            font-size: 1.9rem;
            font-weight: 800;
        }

        .page-header p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.84rem;
        }

        .page-content {
            flex: 1;
            padding: 45px 0 60px;
        }

        .section-title {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 800;
        }

        .section-description {
            margin: 6px 0 0;
            color: var(--text-muted);
            font-size: 0.78rem;
        }

        .tip-card {
            height: 100%;
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border: 1px solid var(--border-color);
            transition:
                transform 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .tip-card:hover {
            transform: translateY(-3px);
            border-color: var(--brand-gold);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
        }

        .tip-header {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 18px;
            border-bottom: 1px solid var(--border-color);
        }

        .tip-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: var(--brand-gold);
        }

        .tip-title {
            margin: 0 0 5px;
            font-size: 0.9rem;
            font-weight: 800;
            line-height: 1.4;
        }

        .tip-category {
            color: var(--text-muted);
            font-size: 0.67rem;
            font-weight: 700;
        }

        .pin-badge {
            margin-left: auto;
            color: var(--brand-gold);
            font-size: 0.68rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .tip-body {
            flex: 1;
            padding: 18px;
        }

        .tip-description {
            margin: 0 0 16px;
            color: var(--text-muted);
            font-size: 0.77rem;
            line-height: 1.65;
        }

        .saving-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            padding: 12px 14px;
        }

        .saving-label {
            display: block;
            color: #166534;
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .saving-value {
            display: block;
            margin-top: 3px;
            color: #15803d;
            font-size: 0.95rem;
            font-weight: 800;
        }

        .tip-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            padding: 14px 18px;
            border-top: 1px solid var(--border-color);
        }

        .tip-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .tip-action {
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: var(--brand-navy);
            padding: 6px 9px;
            font-size: 0.67rem;
            font-weight: 700;
            border-radius: 5px;
            cursor: pointer;
        }

        .tip-action:hover {
            border-color: var(--brand-gold);
            color: var(--brand-gold);
        }

        .tip-action-danger:hover {
            border-color: var(--danger);
            color: var(--danger);
        }

        /* =========================================
           CAROUSEL
           ========================================= */

        .carousel-section {
            margin-top: 50px;
        }

        .carousel-shell {
            position: relative;
            margin-top: 22px;
            overflow: hidden;
            background: var(--brand-navy);
            border: 1px solid #334155;
        }

        .carousel-track {
            display: flex;
            width: 100%;
            transition: transform 0.55s cubic-bezier(0.65, 0, 0.35, 1);
            will-change: transform;
        }

        .tip-slide {
            flex: 0 0 100%;
            min-width: 100%;
            min-height: 285px;
            padding: 40px 90px 55px;
            display: flex;
            align-items: center;
        }

        .tip-slide-content {
            max-width: 780px;
        }

        .universal-badge {
            display: inline-block;
            margin-bottom: 14px;
            background: #fbbf24;
            color: #0f172a;
            padding: 6px 10px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .tip-slide h3 {
            margin-bottom: 12px;
            color: #ffffff;
            font-size: 1.35rem;
            font-weight: 800;
        }

        .tip-slide p {
            margin: 0;
            color: #cbd5e1;
            font-size: 0.82rem;
            line-height: 1.8;
        }

        .carousel-control-custom {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 42px;
            height: 42px;
            border: 1px solid #475569;
            background: #1e293b;
            color: #fbbf24;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 5;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .carousel-control-custom:hover {
            background: var(--brand-gold);
            color: #ffffff;
            border-color: var(--brand-gold);
        }

        .carousel-prev {
            left: 20px;
        }

        .carousel-next {
            right: 20px;
        }

        .carousel-indicators-custom {
            position: absolute;
            bottom: 18px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 7px;
            z-index: 5;
        }

        .carousel-dot {
            width: 8px;
            height: 8px;
            background: #64748b;
            border: none;
            padding: 0;
            cursor: pointer;
            transition: width 0.3s ease, background 0.3s ease;
        }

        .carousel-dot.active {
            width: 22px;
            background: var(--brand-gold-light);
        }

        .empty-state {
            padding: 55px 20px;
            text-align: center;
            background: #ffffff;
            border: 1px solid var(--border-color);
        }

        .empty-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: var(--brand-gold);
            font-size: 1.15rem;
        }

        .empty-state h3 {
            margin-bottom: 7px;
            font-size: 0.98rem;
            font-weight: 800;
        }

        .empty-state p {
            margin: 0;
            color: var(--text-muted);
            font-size: 0.76rem;
        }

        footer {
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }

        @@media (max-width: 991px) {

            .navbar-nav {
                margin-top: 10px;
            }

            .tip-slide {
                padding: 35px 65px 55px;
            }

        }

        @@media (max-width: 576px) {

            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.55rem;
            }

            .tip-slide {
                min-height: 320px;
                padding: 30px 25px 55px;
            }

            .tip-slide h3 {
                font-size: 1.1rem;
            }

            .carousel-prev {
                left: 10px;
            }

            .carousel-next {
                right: 10px;
            }

            .tip-footer {
                align-items: flex-start;
                flex-direction: column;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg main-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Smart Student Budgeting
                    </span>

                </div>

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#studentNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse"
                 id="studentNavbar">

                <div class="navbar-nav mx-auto">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">
                        Dashboard
                    </a>

                    <a asp-controller="Transactions"
                       asp-action="Index"
                       class="nav-link">
                        Transactions
                    </a>

                    <a asp-controller="Budgets"
                       asp-action="Index"
                       class="nav-link">
                        Budgets
                    </a>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="nav-link">
                        Categories
                    </a>

                    <a asp-controller="SavingTips"
                       asp-action="Index"
                       class="nav-link active">
                        Saving Tips
                    </a>

                    <a asp-controller="Bookmarks"
                       asp-action="Index"
                       class="nav-link">
                        Bookmarks
                    </a>

                    <a asp-controller="Notes"
                       asp-action="Index"
                       class="nav-link">
                        Notes
                    </a>

                </div>


                <div class="d-flex align-items-center gap-2">

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-navy btn-sm">

                        <i class="fa-solid fa-user me-1"></i>
                        Profile

                    </a>


                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-navy btn-sm">

                            <i class="fa-solid fa-right-from-bracket me-1"></i>
                            Logout

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </nav>

    <header class="page-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="page-badge">

                <i class="fa-solid fa-piggy-bank me-1"></i>
                Financial Guidance

            </span>

            <h1>
                Saving Tips
            </h1>

            <p>
                Personalized advice based on your spending, plus practical money-saving tips from CampusCoin.
            </p>

        </div>

    </header>

    <main class="page-content">

        <div class="container-fluid px-4 px-lg-5">

            <div>

                <h2 class="section-title">
                    Your Personalized Tips
                </h2>

                <p class="section-description">
                    These tips are generated from your own spending patterns and budgets.
                </p>

            </div>


            @if (Model != null && Model.Count > 0)
            {

                <div class="row g-4 mt-1">

                    @foreach (var tip in Model)
                    {

                        <div class="col-xl-4 col-lg-6">

                            <div class="tip-card">

                                <div class="tip-header">

                                    <div class="tip-icon">
                                        <i class="fa-solid fa-lightbulb"></i>
                                    </div>

                                    <div class="flex-grow-1">

                                        <h3 class="tip-title">
                                            @tip.Title
                                        </h3>

                                        @if (tip.Category != null)
                                        {
                                            <div class="tip-category">
                                                <i class="fa-solid fa-tag me-1"></i>
                                                @tip.Category.Name
                                            </div>
                                        }

                                    </div>

                                    @if (tip.IsPinned)
                                    {
                                        <span class="pin-badge">
                                            <i class="fa-solid fa-thumbtack me-1"></i>
                                            Pinned
                                        </span>
                                    }

                                </div>


                                <div class="tip-body">

                                    <p class="tip-description">
                                        @tip.Description
                                    </p>


                                    @if (tip.PotentialSaving.HasValue &&
                                         tip.PotentialSaving.Value > 0)
                                    {

                                        <div class="saving-box">

                                            <span class="saving-label">
                                                Potential Saving
                                            </span>

                                            <span class="saving-value">
                                                Rs. @tip.PotentialSaving.Value.ToString("N2")
                                            </span>

                                        </div>

                                    }

                                </div>


                                <div class="tip-footer">

                                    <div class="tip-actions">

                                        <!-- Pin -->
                                        <form asp-controller="SavingTips"
                                              asp-action="TogglePin"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@tip.SavingTipId" />

                                            <button type="submit"
                                                    class="tip-action">

                                                <i class="fa-solid fa-thumbtack me-1"></i>

                                                @(tip.IsPinned ? "Unpin" : "Pin")

                                            </button>

                                        </form>


                                        <!-- Bookmark -->
                                        <form asp-controller="Bookmarks"
                                              asp-action="ToggleSavingTip"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@tip.SavingTipId" />

                                            <button type="submit"
                                                    class="tip-action">

                                                <i class="fa-solid fa-bookmark me-1"></i>
                                                Bookmark

                                            </button>

                                        </form>


                                        <!-- Dismiss -->
                                        <form asp-controller="SavingTips"
                                              asp-action="Dismiss"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@tip.SavingTipId" />

                                            <button type="submit"
                                                    class="tip-action tip-action-danger">

                                                <i class="fa-solid fa-xmark me-1"></i>
                                                Dismiss

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            }
            else
            {

                <div class="empty-state mt-3">

                    <div class="empty-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <h3>
                        No Personalized Tips Yet
                    </h3>

                    <p>
                        Keep recording transactions and budgets. CampusCoin will generate personalized advice as your spending history grows.
                    </p>

                </div>

            }

            @if (tipTemplates.Count > 0)
            {

                <section class="carousel-section">

                    <div>

                        <h2 class="section-title">
                            CampusCoin Money Tips
                        </h2>

                        <p class="section-description">
                            Practical saving advice created by CampusCoin administrators for students.
                        </p>

                    </div>


                    <div class="carousel-shell"
                         id="tipsCarousel">

                        <div class="carousel-track"
                             id="tipsTrack">

                            @for (var i = 0; i < tipTemplates.Count; i++)
                            {
                                var template = tipTemplates[i];

                                <div class="tip-slide">

                                    <div class="tip-slide-content">

                                        <span class="universal-badge">

                                            <i class="fa-solid fa-bullseye me-1"></i>
                                            Universal Tip

                                        </span>

                                        <h3>
                                            @template.Title
                                        </h3>

                                        <p>
                                            @template.Description
                                        </p>

                                    </div>

                                </div>
                            }

                        </div>


                        @if (tipTemplates.Count > 1)
                        {

                            <button type="button"
                                    class="carousel-control-custom carousel-prev"
                                    id="tipsPrev"
                                    aria-label="Previous tip">

                                <i class="fa-solid fa-chevron-left"></i>

                            </button>


                            <button type="button"
                                    class="carousel-control-custom carousel-next"
                                    id="tipsNext"
                                    aria-label="Next tip">

                                <i class="fa-solid fa-chevron-right"></i>

                            </button>


                            <div class="carousel-indicators-custom">

                                @for (var i = 0; i < tipTemplates.Count; i++)
                                {
                                    <button type="button"
                                            class="carousel-dot @(i == 0 ? "active" : "")"
                                            data-slide="@i"
                                            aria-label="Go to tip @(i + 1)">
                                    </button>
                                }

                            </div>

                        }

                    </div>

                </section>

            }

            <div class="text-center mt-5">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-outline-navy">

                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Back to Dashboard

                </a>

            </div>


        </div>

    </main>

    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin</strong>
                    · Smart Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const track =
                    document.getElementById("tipsTrack");

                const slides =
                    document.querySelectorAll(".tip-slide");

                const dots =
                    document.querySelectorAll(".carousel-dot");

                const previousButton =
                    document.getElementById("tipsPrev");

                const nextButton =
                    document.getElementById("tipsNext");

                if (!track || slides.length <= 1) {
                    return;
                }

                let currentSlide = 0;
                let autoPlayTimer = null;


                function showSlide(index) {

                    currentSlide =
                        (index + slides.length) % slides.length;

                    // Animate the track horizontally.
                    track.style.transform =
                        "translateX(" +
                        (-currentSlide * 100) +
                        "%)";

                    // Update dot indicators.
                    dots.forEach(
                        (dot, i) => {
                            dot.classList.toggle(
                                "active",
                                i === currentSlide
                            );
                        }
                    );
                }


                function startAutoPlay() {

                    stopAutoPlay();

                    autoPlayTimer =
                        setInterval(
                            function () {

                                showSlide(
                                    currentSlide + 1
                                );

                            },
                            5000
                        );
                }


                function stopAutoPlay() {

                    if (autoPlayTimer) {

                        clearInterval(
                            autoPlayTimer
                        );

                        autoPlayTimer = null;
                    }
                }


                previousButton.addEventListener(
                    "click",
                    function () {

                        showSlide(
                            currentSlide - 1
                        );

                        startAutoPlay();
                    }
                );


                nextButton.addEventListener(
                    "click",
                    function () {

                        showSlide(
                            currentSlide + 1
                        );

                        startAutoPlay();
                    }
                );


                dots.forEach(
                    function (dot) {

                        dot.addEventListener(
                            "click",
                            function () {

                                const slideIndex =
                                    parseInt(
                                        this.dataset.slide
                                    );

                                showSlide(
                                    slideIndex
                                );

                                startAutoPlay();
                            }
                        );

                    }
                );


                const carousel =
                    document.getElementById(
                        "tipsCarousel"
                    );

                carousel.addEventListener(
                    "mouseenter",
                    stopAutoPlay
                );

                carousel.addEventListener(
                    "mouseleave",
                    startAutoPlay
                );


                startAutoPlay();

            }
        );

    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>