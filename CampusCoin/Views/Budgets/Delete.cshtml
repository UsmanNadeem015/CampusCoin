@model CampusCoin.Domain.Entities.Budget

@{
    Layout = null;
    ViewData["Title"] = "Delete Budget";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Delete Budget</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .main-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .nav-link {
            color: var(--brand-navy) !important;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--brand-gold) !important;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-danger {
            background: #dc2626 !important;
            border-color: #dc2626 !important;
            color: #ffffff !important;
        }

        .btn-danger:hover {
            background: #b91c1c !important;
            border-color: #b91c1c !important;
        }

        .page-header {
            background: var(--brand-navy);
            color: #ffffff;
            padding: 42px 0;
        }

        .page-header h1 {
            margin-bottom: 8px;
            font-size: 1.85rem;
            font-weight: 800;
        }

        .page-header p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.84rem;
        }

        .page-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: #fca5a5;
            font-size: 0.67rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .page-content {
            flex: 1;
            padding: 50px 0 60px;
        }

        .delete-card {
            max-width: 700px;
            margin: 0 auto;
            padding: 32px;
            background: #ffffff;
            border: 1px solid #fecaca;
        }

        .warning-icon {
            width: 58px;
            height: 58px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
            font-size: 1.3rem;
        }

        .delete-title {
            margin: 0;
            color: var(--brand-navy);
            font-size: 1.3rem;
            font-weight: 800;
        }

        .delete-description {
            margin: 8px 0 25px;
            color: var(--text-muted);
            font-size: 0.8rem;
            line-height: 1.6;
        }

        .warning-box {
            margin-bottom: 25px;
            padding: 16px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            font-size: 0.78rem;
            line-height: 1.6;
        }

        .budget-details {
            margin-bottom: 28px;
            border: 1px solid var(--border-color);
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 16px 18px;
            border-bottom: 1px solid var(--border-color);
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            color: var(--text-muted);
            font-size: 0.71rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .detail-value {
            color: var(--brand-navy);
            font-size: 0.82rem;
            font-weight: 800;
            text-align: right;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding-top: 22px;
            border-top: 1px solid var(--border-color);
        }

        footer {
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }

        @@media (max-width: 768px) {

            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.55rem;
            }

            .delete-card {
                padding: 24px;
            }

            .detail-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 6px;
            }

            .detail-value {
                text-align: left;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .form-actions .btn {
                width: 100%;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg main-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Smart Student Budgeting
                    </span>

                </div>

            </a>

            <div class="navbar-nav mx-auto">

                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                    Dashboard
                </a>

                <a asp-controller="Transactions" asp-action="Index" class="nav-link">
                    Transactions
                </a>

                <a asp-controller="Budgets" asp-action="Index" class="nav-link active">
                    Budgets
                </a>

                <a asp-controller="Categories" asp-action="Index" class="nav-link">
                    Categories
                </a>

                <a asp-controller="SavingTips" asp-action="Index" class="nav-link">
                    Saving Tips
                </a>

                <a asp-controller="Bookmarks" asp-action="Index" class="nav-link">
                    Bookmarks
                </a>

                <a asp-controller="Notes" asp-action="Index" class="nav-link">
                    Notes
                </a>

            </div>

            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">

                    <i class="fa-solid fa-user me-1"></i>
                    Profile

                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout

                    </button>

                </form>

            </div>

        </div>

    </nav>

    <header class="page-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="page-badge">
                <i class="fa-solid fa-trash-can me-1"></i>
                Budget Planning
            </span>

            <h1 class="mt-3">
                Delete Budget
            </h1>

            <p>
                Review the budget below before permanently removing it.
            </p>

        </div>

    </header>

    <main class="page-content">

        <div class="container-fluid px-4 px-lg-5">

            <div class="delete-card">

                <div class="warning-icon">
                    <i class="fa-solid fa-trash-can"></i>
                </div>

                <h2 class="delete-title">
                    Confirm Budget Deletion
                </h2>

                <p class="delete-description">
                    This action will permanently remove this monthly budget.
                </p>

                <div class="warning-box">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>

                    Make sure you no longer need this budget before
                    continuing. Deleting it cannot be undone.

                </div>

                <div class="budget-details">

                    <div class="detail-row">

                        <span class="detail-label">
                            Category
                        </span>

                        <span class="detail-value">
                            @(Model.Category?.Name ?? "-")
                        </span>

                    </div>

                    <div class="detail-row">

                        <span class="detail-label">
                            Month
                        </span>

                        <span class="detail-value">
                            @Model.Month.ToString("MMMM yyyy")
                        </span>

                    </div>

                    <div class="detail-row">

                        <span class="detail-label">
                            Budget Limit
                        </span>

                        <span class="detail-value">
                            Rs. @Model.LimitAmount.ToString("N2")
                        </span>

                    </div>

                </div>

                <form asp-controller="Budgets"
                      asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.BudgetId" />

                    <div class="form-actions">

                        <a asp-controller="Budgets"
                           asp-action="Index"
                           class="btn btn-outline-navy">

                            <i class="fa-solid fa-xmark me-1"></i>
                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="fa-solid fa-trash-can me-1"></i>
                            Delete Budget

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>

    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin</strong>
                    · Smart Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>

</body>

</html>