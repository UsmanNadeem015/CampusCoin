@model CampusCoin.Domain.Entities.Transaction

@{
    Layout = null;
    ViewData["Title"] = "Transaction Details";

    var isIncome =
        Model.TransactionType
        == CampusCoin.Domain.Enums.TransactionType.Income;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Transaction Details</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        * { box-sizing:border-box; }

        :root {
            --brand-navy:#0f172a;
            --brand-navy-light:#1e293b;
            --brand-gold:#d97706;
            --brand-gold-hover:#b45309;
            --brand-gold-light:#fbbf24;
            --bg-light:#f8fafc;
            --text-muted:#64748b;
            --border-color:#e2e8f0;
            --success:#15803d;
            --danger:#b91c1c;
        }

        body {
            margin:0;
            min-height:100vh;
            display:flex;
            flex-direction:column;
            font-family:'Plus Jakarta Sans',sans-serif;
            background:var(--bg-light);
            color:var(--brand-navy);
        }

        .fa-solid,.fa-regular,.fa-brands {
            font-family:"Font Awesome 6 Free"!important;
        }

        .fa-solid { font-weight:900!important; }

        .main-navbar {
            background:#fff;
            border-bottom:1px solid var(--border-color);
        }

        .brand {
            display:flex;
            align-items:center;
            gap:10px;
            color:var(--brand-navy);
            text-decoration:none;
        }

        .brand-icon {
            width:38px;
            height:38px;
            display:flex;
            align-items:center;
            justify-content:center;
            background:var(--brand-navy);
            border:1px solid var(--brand-gold);
            color:var(--brand-gold-light);
        }

        .brand-name {
            font-size:1.05rem;
            font-weight:800;
            line-height:1;
        }

        .brand-name span { color:var(--brand-gold); }

        .brand-subtitle {
            display:block;
            margin-top:4px;
            color:var(--text-muted);
            font-size:.62rem;
            text-transform:uppercase;
            letter-spacing:.07em;
        }

        .nav-link {
            color:var(--brand-navy)!important;
            font-size:.78rem;
            font-weight:700;
        }

        .nav-link:hover { color:var(--brand-gold)!important; }

        .btn {
            font-weight:700;
            border-radius:5px;
            transition:.2s ease;
        }

        .btn:hover { transform:translateY(-1px); }

        .btn-navy {
            background:var(--brand-navy)!important;
            border-color:var(--brand-navy)!important;
            color:#fff!important;
        }

        .btn-outline-navy {
            background:transparent!important;
            border:1px solid var(--brand-navy)!important;
            color:var(--brand-navy)!important;
        }

        .btn-outline-navy:hover {
            background:var(--brand-navy)!important;
            color:#fff!important;
        }

        .btn-gold {
            background:var(--brand-gold)!important;
            border-color:var(--brand-gold)!important;
            color:#fff!important;
        }

        .btn-gold:hover {
            background:var(--brand-gold-hover)!important;
        }

        .page-header {
            background:var(--brand-navy);
            color:#fff;
            padding:42px 0;
        }

        .page-badge {
            display:inline-block;
            padding:6px 10px;
            background:#020617;
            border:1px solid #475569;
            color:var(--brand-gold-light);
            font-size:.67rem;
            font-weight:800;
            text-transform:uppercase;
        }

        .page-header h1 {
            margin:14px 0 8px;
            font-size:1.9rem;
            font-weight:800;
        }

        .page-header p {
            margin:0;
            color:#94a3b8;
            font-size:.84rem;
        }

        .page-content {
            flex:1;
            padding:42px 0 60px;
        }

        .details-card {
            max-width:900px;
            margin:0 auto;
            background:#fff;
            border:1px solid var(--border-color);
        }

        .details-top {
            padding:25px;
            background:#f8fafc;
            border-bottom:1px solid var(--border-color);
        }

        .amount {
            font-size:1.8rem;
            font-weight:800;
        }

        .amount-income { color:var(--success); }
        .amount-expense { color:var(--danger); }

        .type-badge {
            display:inline-block;
            padding:6px 10px;
            font-size:.68rem;
            font-weight:800;
        }

        .income {
            background:#ecfdf5;
            color:var(--success);
        }

        .expense {
            background:#fef2f2;
            color:var(--danger);
        }

        .details-body {
            padding:25px;
        }

        .detail-item {
            padding:18px;
            border:1px solid var(--border-color);
            height:100%;
        }

        .detail-label {
            display:block;
            color:var(--text-muted);
            font-size:.68rem;
            text-transform:uppercase;
            font-weight:800;
            margin-bottom:7px;
        }

        .detail-value {
            font-size:.88rem;
            font-weight:700;
        }

        .description-box {
            margin-top:18px;
            padding:18px;
            background:#f8fafc;
            border:1px solid var(--border-color);
        }

        .actions {
            margin-top:25px;
            padding-top:20px;
            border-top:1px solid var(--border-color);
            display:flex;
            gap:10px;
            flex-wrap:wrap;
        }

        footer {
            padding:24px 0;
            background:var(--brand-navy);
            color:#94a3b8;
            font-size:.72rem;
        }

        footer strong { color:#fff; }

        @@media (max-width:991px) {
            .navbar-nav { margin-top:10px; }
        }

        @@media (max-width:768px) {
            .details-top,
            .details-body {
                padding:20px;
            }
        }
    </style>

</head>

<body>

<nav class="navbar navbar-expand-lg main-navbar">

    <div class="container-fluid px-4 px-lg-5">

        <a asp-controller="Home"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>
                <div class="brand-name">
                    CAMPUS<span>COIN</span>
                </div>
                <span class="brand-subtitle">
                    Smart Student Budgeting
                </span>
            </div>

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#studentNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="studentNavbar">

            <div class="navbar-nav mx-auto">

                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                    Dashboard
                </a>

                <a asp-controller="Transactions" asp-action="Index" class="nav-link active">
                    Transactions
                </a>

                <a asp-controller="Budgets" asp-action="Index" class="nav-link">
                    Budgets
                </a>

                <a asp-controller="Categories" asp-action="Index" class="nav-link">
                    Categories
                </a>

                <a asp-controller="SavingTips" asp-action="Index" class="nav-link">
                    Saving Tips
                </a>

                <a asp-controller="Bookmarks" asp-action="Index" class="nav-link">
                    Bookmarks
                </a>

                <a asp-controller="Notes" asp-action="Index" class="nav-link">
                    Notes
                </a>

            </div>

            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">
                    <i class="fa-solid fa-user me-1"></i>
                    Profile
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">
                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout
                    </button>

                </form>

            </div>

        </div>

    </div>

</nav>

<header class="page-header">

    <div class="container-fluid px-4 px-lg-5">

        <span class="page-badge">
            <i class="fa-solid fa-receipt me-1"></i>
            Transaction Details
        </span>

        <h1>Transaction Details</h1>

        <p>
            Review the complete information for this transaction.
        </p>

    </div>

</header>

<main class="page-content">

    <div class="container-fluid px-4">

        <div class="details-card">

            <div class="details-top">

                <div class="d-flex
                            flex-column flex-md-row
                            justify-content-between
                            align-items-md-center
                            gap-3">

                    <div>

                        <span class="type-badge @(isIncome ? "income" : "expense")">
                            @(isIncome ? "Income" : "Expense")
                        </span>

                        <div class="amount @(isIncome ? "amount-income" : "amount-expense") mt-2">
                            Rs. @Model.Amount.ToString("N2")
                        </div>

                    </div>

                    <div class="text-md-end">

                        <div class="text-muted"
                             style="font-size:.7rem;">
                            Transaction Date
                        </div>

                        <div style="font-weight:800;">
                            @Model.TransactionDate.ToString("dd MMM yyyy")
                        </div>

                    </div>

                </div>

            </div>


            <div class="details-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="detail-item">

                            <span class="detail-label">
                                Category
                            </span>

                            <div class="detail-value">
                                @(Model.Category?.Name ?? "-")
                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="detail-item">

                            <span class="detail-label">
                                Transaction Type
                            </span>

                            <div class="detail-value">
                                @Model.TransactionType
                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="detail-item">

                            <span class="detail-label">
                                Recurring
                            </span>

                            <div class="detail-value">
                                @(Model.IsRecurring ? "Yes" : "No")
                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="detail-item">

                            <span class="detail-label">
                                Created
                            </span>

                            <div class="detail-value">
                                @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")
                            </div>

                        </div>

                    </div>

                </div>


                <div class="description-box">

                    <span class="detail-label">
                        Description
                    </span>

                    <div class="detail-value">
                        @(Model.Description ?? "No description provided.")
                    </div>

                </div>


                <div class="actions">

                    <a asp-controller="Transactions"
                       asp-action="Edit"
                       asp-route-id="@Model.TransactionId"
                       class="btn btn-gold">

                        <i class="fa-solid fa-pen me-1"></i>
                        Edit

                    </a>

                    <a asp-controller="Transactions"
                       asp-action="Delete"
                       asp-route-id="@Model.TransactionId"
                       class="btn btn-outline-navy">

                        <i class="fa-solid fa-trash me-1"></i>
                        Delete

                    </a>

                    <a asp-controller="Transactions"
                       asp-action="Index"
                       class="btn btn-outline-navy">

                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Back to Transactions

                    </a>

                </div>

            </div>

        </div>

    </div>

</main>

<footer>

    <div class="container-fluid px-4 px-lg-5">

        <div class="d-flex flex-column flex-md-row
                    justify-content-between gap-2">

            <p>
                <strong>CampusCoin</strong>
                · Smart Student Budgeting Platform
            </p>

            <p>© 2026 CampusCoin</p>

        </div>

    </div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>