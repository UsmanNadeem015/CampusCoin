@model CampusCoin.Domain.Entities.Transaction

@{
    Layout = null;
    ViewData["Title"] = "Delete Transaction";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Delete Transaction</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        * { box-sizing:border-box; }

        :root {
            --brand-navy:#0f172a;
            --brand-gold:#d97706;
            --brand-gold-light:#fbbf24;
            --brand-gold-hover:#b45309;
            --bg-light:#f8fafc;
            --text-muted:#64748b;
            --border-color:#e2e8f0;
            --danger:#b91c1c;
            --danger-bg:#fef2f2;
        }

        body {
            margin:0;
            min-height:100vh;
            display:flex;
            flex-direction:column;
            font-family:'Plus Jakarta Sans',sans-serif;
            background:var(--bg-light);
            color:var(--brand-navy);
        }

        .fa-solid,.fa-regular,.fa-brands {
            font-family:"Font Awesome 6 Free"!important;
        }

        .fa-solid { font-weight:900!important; }

        .main-navbar {
            background:#fff;
            border-bottom:1px solid var(--border-color);
        }

        .brand {
            display:flex;
            align-items:center;
            gap:10px;
            color:var(--brand-navy);
            text-decoration:none;
        }

        .brand-icon {
            width:38px;
            height:38px;
            display:flex;
            align-items:center;
            justify-content:center;
            background:var(--brand-navy);
            border:1px solid var(--brand-gold);
            color:var(--brand-gold-light);
        }

        .brand-name {
            font-size:1.05rem;
            font-weight:800;
            line-height:1;
        }

        .brand-name span { color:var(--brand-gold); }

        .brand-subtitle {
            display:block;
            margin-top:4px;
            color:var(--text-muted);
            font-size:.62rem;
            text-transform:uppercase;
            letter-spacing:.07em;
        }

        .nav-link {
            color:var(--brand-navy)!important;
            font-size:.78rem;
            font-weight:700;
        }

        .nav-link:hover { color:var(--brand-gold)!important; }

        .btn {
            font-weight:700;
            border-radius:5px;
            transition:.2s ease;
        }

        .btn:hover { transform:translateY(-1px); }

        .btn-navy {
            background:var(--brand-navy)!important;
            border-color:var(--brand-navy)!important;
            color:#fff!important;
        }

        .btn-outline-navy {
            background:transparent!important;
            border:1px solid var(--brand-navy)!important;
            color:var(--brand-navy)!important;
        }

        .btn-outline-navy:hover {
            background:var(--brand-navy)!important;
            color:#fff!important;
        }

        .btn-danger-custom {
            background:#b91c1c!important;
            border:1px solid #b91c1c!important;
            color:#fff!important;
        }

        .btn-danger-custom:hover {
            background:#991b1b!important;
            border-color:#991b1b!important;
        }

        .page-header {
            background:var(--brand-navy);
            color:#fff;
            padding:42px 0;
        }

        .page-badge {
            display:inline-block;
            padding:6px 10px;
            background:#020617;
            border:1px solid #475569;
            color:var(--brand-gold-light);
            font-size:.67rem;
            font-weight:800;
            text-transform:uppercase;
        }

        .page-header h1 {
            margin:14px 0 8px;
            font-size:1.9rem;
            font-weight:800;
        }

        .page-header p {
            margin:0;
            color:#94a3b8;
            font-size:.84rem;
        }

        .page-content {
            flex:1;
            padding:50px 0 70px;
        }

        .delete-card {
            max-width:720px;
            margin:0 auto;
            background:#fff;
            border:1px solid var(--border-color);
        }

        .warning-box {
            background:var(--danger-bg);
            border:1px solid #fecaca;
            color:#991b1b;
            padding:18px;
        }

        .warning-box h2 {
            margin:0 0 5px;
            font-size:1rem;
            font-weight:800;
        }

        .warning-box p {
            margin:0;
            font-size:.76rem;
        }

        .details {
            padding:25px;
        }

        .detail-row {
            display:flex;
            justify-content:space-between;
            gap:15px;
            padding:13px 0;
            border-bottom:1px solid var(--border-color);
            font-size:.8rem;
        }

        .detail-row:last-child {
            border-bottom:none;
        }

        .detail-label {
            color:var(--text-muted);
            font-weight:700;
        }

        .detail-value {
            font-weight:800;
            text-align:right;
        }

        .actions {
            padding:20px 25px 25px;
            border-top:1px solid var(--border-color);
            display:flex;
            gap:10px;
            flex-wrap:wrap;
        }

        footer {
            padding:24px 0;
            background:var(--brand-navy);
            color:#94a3b8;
            font-size:.72rem;
        }

        footer strong { color:#fff; }

        @@media (max-width:991px) {
            .navbar-nav { margin-top:10px; }
        }

        @@media (max-width:576px) {
            .detail-row {
                flex-direction:column;
                gap:4px;
            }

            .detail-value {
                text-align:left;
            }
        }
    </style>

</head>

<body>

<nav class="navbar navbar-expand-lg main-navbar">

    <div class="container-fluid px-4 px-lg-5">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>
                <div class="brand-name">
                    CAMPUS<span>COIN</span>
                </div>

                <span class="brand-subtitle">
                    Smart Student Budgeting
                </span>
            </div>

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#studentNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="studentNavbar">

            <div class="navbar-nav mx-auto">

                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                    Dashboard
                </a>

                <a asp-controller="Transactions" asp-action="Index" class="nav-link active">
                    Transactions
                </a>

                <a asp-controller="Budgets" asp-action="Index" class="nav-link">
                    Budgets
                </a>

                <a asp-controller="Categories" asp-action="Index" class="nav-link">
                    Categories
                </a>

                <a asp-controller="SavingTips" asp-action="Index" class="nav-link">
                    Saving Tips
                </a>

                <a asp-controller="Bookmarks" asp-action="Index" class="nav-link">
                    Bookmarks
                </a>

                <a asp-controller="Notes" asp-action="Index" class="nav-link">
                    Notes
                </a>

            </div>

            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">
                    <i class="fa-solid fa-user me-1"></i>
                    Profile
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">
                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout
                    </button>

                </form>

            </div>

        </div>

    </div>

</nav>

<header class="page-header">

    <div class="container-fluid px-4 px-lg-5">

        <span class="page-badge">
            <i class="fa-solid fa-trash me-1"></i>
            Transaction Management
        </span>

        <h1>Delete Transaction</h1>

        <p>
            Review the transaction before permanently removing it.
        </p>

    </div>

</header>

<main class="page-content">

    <div class="container-fluid px-4">

        <div class="delete-card">

            <div class="warning-box">

                <h2>
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    Are you sure?
                </h2>

                <p>
                    This transaction will be permanently deleted and cannot be recovered.
                </p>

            </div>


            <div class="details">

                <div class="detail-row">

                    <span class="detail-label">
                        Date
                    </span>

                    <span class="detail-value">
                        @Model.TransactionDate.ToString("dd MMM yyyy")
                    </span>

                </div>

                <div class="detail-row">

                    <span class="detail-label">
                        Category
                    </span>

                    <span class="detail-value">
                        @(Model.Category?.Name ?? "-")
                    </span>

                </div>

                <div class="detail-row">

                    <span class="detail-label">
                        Type
                    </span>

                    <span class="detail-value">
                        @Model.TransactionType
                    </span>

                </div>

                <div class="detail-row">

                    <span class="detail-label">
                        Amount
                    </span>

                    <span class="detail-value">
                        Rs. @Model.Amount.ToString("N2")
                    </span>

                </div>

                <div class="detail-row">

                    <span class="detail-label">
                        Description
                    </span>

                    <span class="detail-value">
                        @(Model.Description ?? "-")
                    </span>

                </div>

            </div>


            <div class="actions">

                <form asp-controller="Transactions"
                      asp-action="DeleteConfirmed"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.TransactionId" />

                    <button type="submit"
                            class="btn btn-danger-custom">

                        <i class="fa-solid fa-trash me-1"></i>
                        Yes, Delete

                    </button>

                </form>

                <a asp-controller="Transactions"
                   asp-action="Index"
                   class="btn btn-outline-navy">

                    Cancel

                </a>

            </div>

        </div>

    </div>

</main>

<footer>

    <div class="container-fluid px-4 px-lg-5">

        <div class="d-flex flex-column flex-md-row
                    justify-content-between gap-2">

            <p>
                <strong>CampusCoin</strong>
                · Smart Student Budgeting Platform
            </p>

            <p>© 2026 CampusCoin</p>

        </div>

    </div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>