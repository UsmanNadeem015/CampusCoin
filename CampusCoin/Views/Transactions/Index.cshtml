@model IEnumerable<CampusCoin.Domain.Entities.Transaction>

@{
    Layout = null;
    ViewData["Title"] = "Transactions";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Transactions</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --success: #15803d;
            --danger: #b91c1c;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .main-navbar {
            background: #fff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .nav-link {
            color: var(--brand-navy) !important;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--brand-gold) !important;
        }

        .btn {
            font-weight: 700;
            border-radius: 5px;
            transition: .2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #fff !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #fff !important;
        }

        .btn-gold {
            background: var(--brand-gold) !important;
            border-color: var(--brand-gold) !important;
            color: #fff !important;
        }

        .btn-gold:hover {
            background: var(--brand-gold-hover) !important;
        }

        .page-header {
            background: var(--brand-navy);
            color: #fff;
            padding: 42px 0;
            border-bottom: 1px solid #334155;
        }

        .page-header h1 {
            margin: 14px 0 8px;
            font-size: 1.9rem;
            font-weight: 800;
        }

        .page-header p {
            margin: 0;
            color: #94a3b8;
            font-size: .84rem;
        }

        .page-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: var(--brand-gold-light);
            font-size: .67rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .page-content {
            flex: 1;
            padding: 40px 0 60px;
        }

        .content-card {
            background: #fff;
            border: 1px solid var(--border-color);
        }

        .card-header-custom {
            padding: 20px 22px;
            border-bottom: 1px solid var(--border-color);
        }

        .card-header-custom h2 {
            margin: 0;
            font-size: 1rem;
            font-weight: 800;
        }

        .card-header-custom p {
            margin: 5px 0 0;
            color: var(--text-muted);
            font-size: .75rem;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .transaction-table {
            margin: 0;
            min-width: 850px;
        }

        .transaction-table th {
            background: #f8fafc;
            color: var(--text-muted);
            font-size: .65rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 800;
            padding: 14px 16px;
            white-space: nowrap;
        }

        .transaction-table td {
            padding: 15px 16px;
            vertical-align: middle;
            font-size: .76rem;
            border-color: var(--border-color);
        }

        .date-text {
            color: var(--text-muted);
            white-space: nowrap;
        }

        .category-name {
            font-weight: 700;
        }

        .type-badge {
            display: inline-block;
            padding: 5px 9px;
            font-size: .64rem;
            font-weight: 800;
        }

        .income {
            background: #ecfdf5;
            color: var(--success);
        }

        .expense {
            background: #fef2f2;
            color: var(--danger);
        }

        .income-amount {
            color: var(--success);
            font-weight: 800;
        }

        .expense-amount {
            color: var(--danger);
            font-weight: 800;
        }

        .action-buttons {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: var(--brand-gold);
        }

        .empty-state h3 {
            font-size: 1rem;
            font-weight: 800;
        }

        .empty-state p {
            color: var(--text-muted);
            font-size: .78rem;
        }

        footer {
            margin-top: auto;
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
            font-size: .72rem;
        }

        footer strong {
            color: #fff;
        }

        @@media (max-width: 991px) {
            .navbar-nav {
                margin-top: 10px;
            }
        }

        @@media (max-width: 768px) {
            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.55rem;
            }
        }
    </style>

</head>

<body>

<nav class="navbar navbar-expand-lg main-navbar">

    <div class="container-fluid px-4 px-lg-5">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>
                <div class="brand-name">
                    CAMPUS<span>COIN</span>
                </div>

                <span class="brand-subtitle">
                    Smart Student Budgeting
                </span>
            </div>

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#studentNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="studentNavbar">

            <div class="navbar-nav mx-auto">

                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                    Dashboard
                </a>

                <a asp-controller="Transactions" asp-action="Index" class="nav-link active">
                    Transactions
                </a>

                <a asp-controller="Budgets" asp-action="Index" class="nav-link">
                    Budgets
                </a>

                <a asp-controller="Categories" asp-action="Index" class="nav-link">
                    Categories
                </a>

                <a asp-controller="SavingTips" asp-action="Index" class="nav-link">
                    Saving Tips
                </a>

                <a asp-controller="Bookmarks" asp-action="Index" class="nav-link">
                    Bookmarks
                </a>

                <a asp-controller="Notes" asp-action="Index" class="nav-link">
                    Notes
                </a>

            </div>

            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">
                    <i class="fa-solid fa-user me-1"></i>
                    Profile
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">
                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout
                    </button>

                </form>

            </div>

        </div>

    </div>

</nav>

<header class="page-header">
    <div class="container-fluid px-4 px-lg-5">

        <span class="page-badge">
            <i class="fa-solid fa-receipt me-1"></i>
            Transaction Management
        </span>

        <h1>Transactions</h1>

        <p>
            Record, review and manage your income and expenses.
        </p>

    </div>
</header>

<main class="page-content">

    <div class="container-fluid px-4 px-lg-5">

        <div class="content-card">

            <div class="card-header-custom
                        d-flex
                        flex-column flex-md-row
                        justify-content-between
                        align-items-md-center
                        gap-3">

                <div>
                    <h2>Your Transactions</h2>
                    <p>All recorded income and expense entries.</p>
                </div>

                <a asp-action="Create"
                   class="btn btn-gold btn-sm">
                    <i class="fa-solid fa-plus me-1"></i>
                    Add Transaction
                </a>

            </div>

            @if (Model.Any())
            {
                <div class="table-wrapper">

                    <table class="table transaction-table">

                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>

                        <tbody>

                        @foreach (var transaction in Model)
                        {
                            var isIncome =
                                transaction.TransactionType
                                == CampusCoin.Domain.Enums.TransactionType.Income;

                            <tr>

                                <td class="date-text">
                                    @transaction.TransactionDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="category-name">
                                    @(transaction.Category?.Name ?? "-")
                                </td>

                                <td>
                                    <span class="type-badge @(isIncome ? "income" : "expense")">
                                        @(isIncome ? "Income" : "Expense")
                                    </span>
                                </td>

                                <td>
                                    @(transaction.Description ?? "-")
                                </td>

                                <td class="@(isIncome ? "income-amount" : "expense-amount")">
                                    Rs. @transaction.Amount.ToString("N2")
                                </td>

                                <td>
                                    <div class="action-buttons justify-content-end">

                                        <a asp-action="Details"
                                           asp-route-id="@transaction.TransactionId"
                                           class="btn btn-outline-navy btn-sm">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@transaction.TransactionId"
                                           class="btn btn-outline-navy btn-sm">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@transaction.TransactionId"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="fa-solid fa-receipt"></i>
                    </div>

                    <h3>No Transactions Yet</h3>

                    <p>
                        Start tracking your money by adding your first transaction.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-gold btn-sm">
                        <i class="fa-solid fa-plus me-1"></i>
                        Add Transaction
                    </a>

                </div>
            }

        </div>

    </div>

</main>

<footer>

    <div class="container-fluid px-4 px-lg-5">

        <div class="d-flex
                    flex-column
                    flex-md-row
                    justify-content-between
                    gap-2">

            <p>
                <strong>CampusCoin</strong>
                · Smart Student Budgeting Platform
            </p>

            <p>
                © 2026 CampusCoin
            </p>

        </div>

    </div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>