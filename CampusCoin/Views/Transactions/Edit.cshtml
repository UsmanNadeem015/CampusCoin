@model CampusCoin.Domain.Entities.Transaction
@using CampusCoin.Domain.Entities

@{
    Layout = null;
    ViewData["Title"] = "Edit Transaction";

    var categories = ViewBag.Categories as List<Category>
                     ?? new List<Category>();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - Edit Transaction</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        * { box-sizing: border-box; }

        :root {
            --brand-navy:#0f172a;
            --brand-navy-light:#1e293b;
            --brand-gold:#d97706;
            --brand-gold-hover:#b45309;
            --brand-gold-light:#fbbf24;
            --bg-light:#f8fafc;
            --text-muted:#64748b;
            --border-color:#e2e8f0;
        }

        body {
            margin:0;
            min-height:100vh;
            display:flex;
            flex-direction:column;
            font-family:'Plus Jakarta Sans',sans-serif;
            background:var(--bg-light);
            color:var(--brand-navy);
        }

        .fa-solid,.fa-regular,.fa-brands {
            font-family:"Font Awesome 6 Free"!important;
        }

        .fa-solid {
            font-weight:900!important;
        }

        .main-navbar {
            background:#fff;
            border-bottom:1px solid var(--border-color);
        }

        .brand {
            display:flex;
            align-items:center;
            gap:10px;
            color:var(--brand-navy);
            text-decoration:none;
        }

        .brand-icon {
            width:38px;
            height:38px;
            display:flex;
            align-items:center;
            justify-content:center;
            background:var(--brand-navy);
            border:1px solid var(--brand-gold);
            color:var(--brand-gold-light);
        }

        .brand-name {
            font-size:1.05rem;
            font-weight:800;
            line-height:1;
        }

        .brand-name span { color:var(--brand-gold); }

        .brand-subtitle {
            display:block;
            margin-top:4px;
            color:var(--text-muted);
            font-size:.62rem;
            text-transform:uppercase;
            letter-spacing:.07em;
        }

        .nav-link {
            color:var(--brand-navy)!important;
            font-size:.78rem;
            font-weight:700;
        }

        .nav-link:hover {
            color:var(--brand-gold)!important;
        }

        .btn {
            font-weight:700;
            border-radius:5px;
            transition:.2s ease;
        }

        .btn:hover {
            transform:translateY(-1px);
        }

        .btn-navy {
            background:var(--brand-navy)!important;
            border-color:var(--brand-navy)!important;
            color:#fff!important;
        }

        .btn-gold {
            background:var(--brand-gold)!important;
            border-color:var(--brand-gold)!important;
            color:#fff!important;
        }

        .btn-gold:hover {
            background:var(--brand-gold-hover)!important;
        }

        .btn-outline-navy {
            background:transparent!important;
            border:1px solid var(--brand-navy)!important;
            color:var(--brand-navy)!important;
        }

        .btn-outline-navy:hover {
            background:var(--brand-navy)!important;
            color:#fff!important;
        }

        .page-header {
            background-color: var(--brand-navy);
            background-image: linear-gradient(rgba(15, 23, 42, 0.78), rgba(15, 23, 42, 0.85)), url('/images/banners/transactions-banner.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            color: #fff;
            padding: 42px 0;
        }

        .page-badge {
            display:inline-block;
            padding:6px 10px;
            background:#020617;
            border:1px solid #475569;
            color:var(--brand-gold-light);
            font-size:.67rem;
            font-weight:800;
            text-transform:uppercase;
        }

        .page-header h1 {
            margin:14px 0 8px;
            font-size:1.9rem;
            font-weight:800;
        }

        .page-header p {
            margin:0;
            color:#94a3b8;
            font-size:.84rem;
        }

        .page-content {
            flex:1;
            padding:42px 0 60px;
        }

        .form-card {
            max-width:850px;
            margin:0 auto;
            background:#fff;
            border:1px solid var(--border-color);
            padding:30px;
        }

        .form-section-title {
            font-size:1rem;
            font-weight:800;
            margin-bottom:5px;
        }

        .form-section-text {
            font-size:.76rem;
            color:var(--text-muted);
            margin-bottom:25px;
        }

        .form-label {
            font-size:.76rem;
            font-weight:800;
            margin-bottom:7px;
        }

        .form-control,
        .form-select {
            border:1px solid var(--border-color);
            border-radius:6px;
            padding:11px 12px;
            font-family:inherit;
            font-size:.82rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color:var(--brand-gold);
            box-shadow:0 0 0 3px rgba(217,119,6,.12);
        }

        textarea.form-control {
            min-height:130px;
        }

        .form-check-input:checked {
            background-color:var(--brand-gold);
            border-color:var(--brand-gold);
        }

        .field-validation-error,
        .validation-summary-errors {
            color:#b91c1c;
            font-size:.72rem;
            margin-top:6px;
            display:block;
        }

        .validation-summary-errors ul {
            margin:0;
            padding-left:18px;
        }

        .form-actions {
            margin-top:30px;
            padding-top:22px;
            border-top:1px solid var(--border-color);
            display:flex;
            gap:10px;
            flex-wrap:wrap;
        }

        footer {
            padding:24px 0;
            background:var(--brand-navy);
            color:#94a3b8;
            font-size:.72rem;
        }

        footer strong { color:#fff; }

        @@media (max-width:991px) {
            .navbar-nav { margin-top:10px; }
        }

        @@media (max-width:768px) {
            .form-card { padding:20px; }
        }
    </style>

</head>

<body>

<nav class="navbar navbar-expand-lg main-navbar">

    <div class="container-fluid px-4 px-lg-5">

        <a asp-controller="Home"
           asp-action="Index"
           class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>
                <div class="brand-name">
                    CAMPUS<span>COIN</span>
                </div>

                <span class="brand-subtitle">
                    Smart Student Budgeting
                </span>
            </div>

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#studentNavbar">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="studentNavbar">

            <div class="navbar-nav mx-auto">

                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                    Dashboard
                </a>

                <a asp-controller="Transactions" asp-action="Index" class="nav-link active">
                    Transactions
                </a>

                <a asp-controller="Budgets" asp-action="Index" class="nav-link">
                    Budgets
                </a>

                <a asp-controller="Categories" asp-action="Index" class="nav-link">
                    Categories
                </a>

                <a asp-controller="SavingTips" asp-action="Index" class="nav-link">
                    Saving Tips
                </a>

                <a asp-controller="Bookmarks" asp-action="Index" class="nav-link">
                    Bookmarks
                </a>

                <a asp-controller="Notes" asp-action="Index" class="nav-link">
                    Notes
                </a>

            </div>

            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-navy btn-sm">
                    <i class="fa-solid fa-user me-1"></i>
                    Profile
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-navy btn-sm">
                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout
                    </button>

                </form>

            </div>

        </div>

    </div>

</nav>

<header class="page-header">

    <div class="container-fluid px-4 px-lg-5">

        <span class="page-badge">
            <i class="fa-solid fa-pen me-1"></i>
            Transaction Management
        </span>

        <h1>Edit Transaction</h1>

        <p>
            Update the details of this transaction.
        </p>

    </div>

</header>

<main class="page-content">

    <div class="container-fluid px-4">

        <div class="form-card">

            <div class="form-section-title">
                Update Transaction
            </div>

            <div class="form-section-text">
                Change the transaction details below and save your changes.
            </div>

            <form asp-controller="Transactions"
                  asp-action="Edit"
                  asp-route-id="@Model.TransactionId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="validation-summary-errors mb-3">
                </div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="TransactionType"
                               class="form-label">
                            Transaction Type
                        </label>

                        <select asp-for="TransactionType"
                                id="TransactionType"
                                class="form-select">

                            <option value="1">Income</option>
                            <option value="2">Expense</option>

                        </select>

                        <span asp-validation-for="TransactionType"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Amount"
                               class="form-label">
                            Amount (PKR)
                        </label>

                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                        <span asp-validation-for="Amount"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CategoryId"
                               class="form-label">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                id="CategoryId"
                                class="form-select">

                            <option value="">
                                Select Category
                            </option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.Name (@category.Type)
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoryId"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="TransactionDate"
                               class="form-label">
                            Transaction Date
                        </label>

                        <input asp-for="TransactionDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="TransactionDate"></span>

                    </div>

                    <div class="col-12">

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      id="Description"
                                      class="form-control"
                                      rows="3"
                                      maxlength="250"
                                      placeholder="Example: Coffee and sandwich at Campus Cafe"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                            <div class="d-flex align-items-center gap-2 flex-wrap mt-2">

                                <button type="button"
                                        id="aiSuggestButton"
                                        class="btn btn-outline-navy btn-sm">

                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>
                                    Suggest Category with AI

                                </button>

                                <span id="aiSuggestionStatus"
                                      class="text-muted"
                                      style="font-size:.72rem;"
                                      aria-live="polite">
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="IsRecurring"
                                   type="checkbox"
                                   class="form-check-input" />

                            <label asp-for="IsRecurring"
                                   class="form-check-label"
                                   style="font-size:.78rem;font-weight:700;">
                                Recurring Transaction
                            </label>

                        </div>

                    </div>

                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn btn-gold">

                        <i class="fa-solid fa-check me-1"></i>
                        Save Changes

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-navy">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</main>

<footer>

    <div class="container-fluid px-4 px-lg-5">

        <div class="d-flex flex-column flex-md-row
                    justify-content-between gap-2">

            <p>
                <strong>CampusCoin</strong>
                · Smart Student Budgeting Platform
            </p>

            <p>© 2026 CampusCoin</p>

        </div>

    </div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const descriptionInput =
                document.getElementById("Description");

            const transactionTypeSelect =
                document.getElementById("TransactionType");

            const categorySelect =
                document.getElementById("CategoryId");

            const suggestButton =
                document.getElementById("aiSuggestButton");

            const statusText =
                document.getElementById("aiSuggestionStatus");

            let suggestionTimer = null;
            let lastDescription = descriptionInput.value.trim();

            function setStatus(message, type = "muted") {

                statusText.textContent = message;

                statusText.className = "";

                statusText.style.fontSize = ".72rem";

                if (type === "success") {
                    statusText.classList.add("text-success");
                }
                else if (type === "danger") {
                    statusText.classList.add("text-danger");
                }
                else {
                    statusText.classList.add("text-muted");
                }
            }

            async function suggestCategory() {

                const description =
                    descriptionInput.value.trim();

                const transactionType =
                    parseInt(transactionTypeSelect.value);

                if (!description || description.length < 3) {

                    setStatus("");

                    return;
                }

                if (isNaN(transactionType)) {

                    setStatus(
                        "Select a transaction type first.",
                        "danger"
                    );

                    return;
                }

                lastDescription = description;

                suggestButton.disabled = true;

                setStatus(
                    "AI is suggesting a category..."
                );

                const tokenInput =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    );

                try {

                    const response = await fetch(
                        '@Url.Action("SuggestCategory", "Transactions")',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken":
                                    tokenInput.value
                            },

                            body: JSON.stringify({
                                description: description,
                                transactionType: transactionType
                            })
                        }
                    );

                    if (!response.ok) {

                        throw new Error(
                            "AI suggestion request failed."
                        );
                    }

                    const result =
                        await response.json();

                    if (result.success) {

                        categorySelect.value =
                            result.categoryId;

                        setStatus(
                            `Suggested: ${result.categoryName}`,
                            "success"
                        );

                    }
                    else {

                        setStatus(
                            result.message ||
                            "No suitable category suggestion found.",
                            "danger"
                        );
                    }

                }
                catch (error) {

                    console.error(error);

                    setStatus(
                        "Could not get an AI suggestion. You can select a category manually.",
                        "danger"
                    );

                }
                finally {

                    suggestButton.disabled = false;
                }
            }

            function scheduleSuggestion() {

                clearTimeout(suggestionTimer);

                suggestionTimer =
                    setTimeout(
                        suggestCategory,
                        800
                    );
            }

            descriptionInput.addEventListener(
                "input",
                function () {

                    const currentDescription =
                        descriptionInput.value.trim();

                    if (currentDescription === lastDescription) {
                        return;
                    }

                    scheduleSuggestion();
                }
            );

            transactionTypeSelect.addEventListener(
                "change",
                function () {

                    lastDescription = "";

                    if (descriptionInput.value.trim()) {
                        scheduleSuggestion();
                    }
                    else {
                        setStatus("");
                    }
                }
            );

            suggestButton.addEventListener(
                "click",
                function () {

                    lastDescription = "";

                    suggestCategory();
                }
            );

        });
    </script>
}

</body>
</html>