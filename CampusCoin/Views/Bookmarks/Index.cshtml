@model List<CampusCoin.Domain.Entities.Bookmark>

@{
    Layout = null;
    ViewData["Title"] = "My Bookmarks";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CampusCoin - My Bookmarks</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }


        /* =========================================
           NAVBAR
           ========================================= */

        .main-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--brand-navy);
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .nav-link {
            color: var(--brand-navy) !important;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--brand-gold) !important;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-gold {
            background: var(--brand-gold) !important;
            border-color: var(--brand-gold) !important;
            color: #ffffff !important;
        }

        .btn-gold:hover {
            background: var(--brand-gold-hover) !important;
            border-color: var(--brand-gold-hover) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }


        /* =========================================
           PAGE HEADER
           ========================================= */

        .page-header {
            background: var(--brand-navy);
            color: #ffffff;
            padding: 42px 0;
        }

        .page-header h1 {
            margin-bottom: 8px;
            font-size: 1.85rem;
            font-weight: 800;
        }

        .page-header p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.84rem;
        }

        .page-badge {
            display: inline-block;
            padding: 6px 10px;
            background: #020617;
            border: 1px solid #475569;
            color: var(--brand-gold-light);
            font-size: 0.67rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }


        /* =========================================
           MAIN CONTENT
           ========================================= */

        .page-content {
            flex: 1;
            padding: 45px 0 60px;
        }

        .bookmark-summary {
            margin-bottom: 28px;
            padding: 20px 22px;
            background: #ffffff;
            border: 1px solid var(--border-color);
        }

        .summary-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 1rem;
        }

        .summary-label {
            display: block;
            margin-bottom: 4px;
            color: var(--text-muted);
            font-size: 0.69rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .summary-value {
            margin: 0;
            color: var(--brand-navy);
            font-size: 1.55rem;
            font-weight: 800;
        }


        /* =========================================
           BOOKMARK CARDS
           ========================================= */

        .bookmark-card {
            height: 100%;
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border: 1px solid var(--border-color);
            transition:
                transform 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .bookmark-card:hover {
            transform: translateY(-3px);
            border-color: var(--brand-gold);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.07);
        }

        .bookmark-card-header {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 22px;
            border-bottom: 1px solid var(--border-color);
        }

        .bookmark-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: var(--brand-gold);
        }

        .bookmark-title {
            margin: 0;
            color: var(--brand-navy);
            font-size: 1rem;
            font-weight: 800;
            line-height: 1.4;
        }

        .bookmark-type {
            display: inline-block;
            margin-top: 6px;
            padding: 4px 8px;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .bookmark-body {
            flex: 1;
            padding: 22px;
        }

        .bookmark-description {
            margin-bottom: 18px;
            color: var(--text-muted);
            font-size: 0.8rem;
            line-height: 1.7;
        }

        .saving-box {
            margin-bottom: 18px;
            padding: 14px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
        }

        .saving-label {
            display: block;
            margin-bottom: 3px;
            color: var(--text-muted);
            font-size: 0.67rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .saving-value {
            color: #166534;
            font-size: 1rem;
            font-weight: 800;
        }

        .insight-section {
            margin-bottom: 16px;
            padding: 14px;
            background: #f8fafc;
            border-left: 3px solid var(--brand-gold);
        }

        .insight-label {
            margin-bottom: 5px;
            color: var(--brand-navy);
            font-size: 0.72rem;
            font-weight: 800;
        }

        .insight-text {
            margin: 0;
            color: var(--text-muted);
            font-size: 0.77rem;
            line-height: 1.6;
        }

        .bookmark-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 22px;
            border-top: 1px solid var(--border-color);
        }

        .bookmark-date {
            color: var(--text-muted);
            font-size: 0.68rem;
        }

        .bookmark-date i {
            color: var(--brand-gold);
        }


        /* =========================================
           EMPTY STATE
           ========================================= */

        .empty-state {
            padding: 75px 20px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            text-align: center;
        }

        .empty-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: var(--brand-gold);
            font-size: 1.4rem;
        }

        .empty-state h2 {
            margin-bottom: 8px;
            color: var(--brand-navy);
            font-size: 1.15rem;
            font-weight: 800;
        }

        .empty-state p {
            max-width: 500px;
            margin: 0 auto 20px;
            color: var(--text-muted);
            font-size: 0.8rem;
            line-height: 1.6;
        }


        /* =========================================
           FOOTER
           ========================================= */

        footer {
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }


        /* =========================================
           RESPONSIVE
           ========================================= */

        @@media (max-width: 991px) {

            .nav-links {
                margin-top: 10px;
            }

        }

        @@media (max-width: 768px) {

            .page-header {
                padding: 35px 0;
            }

            .page-header h1 {
                font-size: 1.55rem;
            }

            .bookmark-card-header,
            .bookmark-body {
                padding: 18px;
            }

            .bookmark-footer {
                padding: 14px 18px;
            }

        }

    </style>

</head>

<body>


    <!-- =========================================
         NAVBAR
         ========================================= -->

    <nav class="navbar navbar-expand-lg main-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Smart Student Budgeting
                    </span>

                </div>

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#studentNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse"
                 id="studentNavbar">

                <div class="navbar-nav mx-auto nav-links">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">
                        Dashboard
                    </a>

                    <a asp-controller="Transactions"
                       asp-action="Index"
                       class="nav-link">
                        Transactions
                    </a>

                    <a asp-controller="SavingTips"
                       asp-action="Index"
                       class="nav-link">
                        Saving Tips
                    </a>

                    <a asp-controller="Bookmarks"
                       asp-action="Index"
                       class="nav-link active">
                        Bookmarks
                    </a>

                    <a asp-controller="Notes"
                       asp-action="Index"
                       class="nav-link">
                        Notes
                    </a>

                </div>


                <div class="d-flex align-items-center gap-2">

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-navy btn-sm">

                        <i class="fa-solid fa-user me-1"></i>
                        Profile

                    </a>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-navy btn-sm">

                            <i class="fa-solid fa-right-from-bracket me-1"></i>
                            Logout

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </nav>


    <!-- =========================================
         PAGE HEADER
         ========================================= -->

    <header class="page-header">

        <div class="container-fluid px-4 px-lg-5">

            <span class="page-badge">

                <i class="fa-solid fa-bookmark me-1"></i>
                Saved Items

            </span>

            <h1 class="mt-3">
                My Bookmarks
            </h1>

            <p>
                Keep your useful saving tips and monthly insights in one place.
            </p>

        </div>

    </header>


    <!-- =========================================
         MAIN CONTENT
         ========================================= -->

    <main class="page-content">

        <div class="container-fluid px-4 px-lg-5">


            <!-- SUMMARY -->

            <div class="bookmark-summary">

                <div class="d-flex align-items-center gap-3">

                    <div class="summary-icon">

                        <i class="fa-solid fa-bookmark"></i>

                    </div>

                    <div>

                        <span class="summary-label">
                            Saved Items
                        </span>

                        <h2 class="summary-value">
                            @Model.Count
                        </h2>

                    </div>

                </div>

            </div>


            @if (Model.Count == 0)
            {
                <!-- EMPTY STATE -->

                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="fa-regular fa-bookmark"></i>
                    </div>

                    <h2>
                        No Bookmarks Yet
                    </h2>

                    <p>
                        Save useful saving tips or monthly insights and
                        they will appear here for quick access later.
                    </p>

                    <a asp-controller="SavingTips"
                       asp-action="Index"
                       class="btn btn-gold">

                        <i class="fa-solid fa-lightbulb me-1"></i>
                        Browse Saving Tips

                    </a>

                </div>
            }
            else
            {
                <!-- BOOKMARK GRID -->

                <div class="row g-4">

                    @foreach (var bookmark in Model)
                    {
                        <div class="col-lg-6">

                            <article class="bookmark-card">


                                @if (bookmark.SavingTip != null)
                                {
                                    <div class="bookmark-card-header">

                                        <div class="bookmark-icon">

                                            <i class="fa-solid fa-lightbulb"></i>

                                        </div>

                                        <div>

                                            <h2 class="bookmark-title">
                                                @bookmark.SavingTip.Title
                                            </h2>

                                            <span class="bookmark-type">
                                                Saving Tip
                                            </span>

                                        </div>

                                    </div>


                                    <div class="bookmark-body">

                                        <p class="bookmark-description">
                                            @bookmark.SavingTip.Description
                                        </p>


                                        @if (bookmark.SavingTip.PotentialSaving.HasValue)
                                        {
                                            <div class="saving-box">

                                                <span class="saving-label">
                                                    Potential Saving
                                                </span>

                                                <span class="saving-value">
                                                    Rs.
                                                    @bookmark.SavingTip.PotentialSaving.Value.ToString("N2")
                                                </span>

                                            </div>
                                        }

                                    </div>
                                }


                                @if (bookmark.Insight != null)
                                {
                                    <div class="bookmark-card-header">

                                        <div class="bookmark-icon">

                                            <i class="fa-solid fa-chart-line"></i>

                                        </div>

                                        <div>

                                            <h2 class="bookmark-title">
                                                Monthly Insight
                                            </h2>

                                            <span class="bookmark-type">
                                                Insight
                                            </span>

                                        </div>

                                    </div>


                                    <div class="bookmark-body">

                                        <div class="insight-section">

                                            <div class="insight-label">
                                                Summary
                                            </div>

                                            <p class="insight-text">
                                                @bookmark.Insight.SummaryText
                                            </p>

                                        </div>

                                        <div class="insight-section">

                                            <div class="insight-label">
                                                Tip
                                            </div>

                                            <p class="insight-text">
                                                @bookmark.Insight.TipText
                                            </p>

                                        </div>

                                    </div>
                                }


                                <div class="bookmark-footer">

                                    <span class="bookmark-date">

                                        <i class="fa-regular fa-calendar me-1"></i>

                                        Bookmarked
                                        @bookmark.CreatedAt
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy")

                                    </span>


                                    @if (bookmark.SavingTipId.HasValue)
                                    {
                                        <form asp-controller="Bookmarks"
                                              asp-action="ToggleSavingTip"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@bookmark.SavingTipId.Value" />

                                            <button type="submit"
                                                    class="btn btn-outline-navy btn-sm">

                                                <i class="fa-solid fa-bookmark-slash me-1"></i>
                                                Remove

                                            </button>

                                        </form>
                                    }

                                </div>

                            </article>

                        </div>
                    }

                </div>
            }

        </div>

    </main>


    <!-- =========================================
         FOOTER
         ========================================= -->

    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin</strong>
                    · Smart Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>