@using CampusCoin.Domain.Entities

@{
    Layout = null;

    var insight = Model as Insight;

    var selectedMonth =
        ViewBag.SelectedMonth as string
        ?? DateTime.Today.ToString("yyyy-MM");

    var monthDisplay =
        ViewBag.MonthDisplay as string
        ?? DateTime.Today.ToString("MMMM yyyy");

    var history =
        ViewBag.History as List<Insight>
        ?? new List<Insight>();

    var successMessage =
        TempData["AIInsightSuccess"] as string;

    var errorMessage =
        TempData["AIInsightError"] as string;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>AI Insights - CampusCoin</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --brand-navy: #0f172a;
            --brand-navy-light: #1e293b;
            --brand-gold: #d97706;
            --brand-gold-hover: #b45309;
            --brand-gold-light: #fbbf24;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --success: #16a34a;
            --danger: #dc2626;
        }

        html {
            height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family:
                'Plus Jakarta Sans',
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                sans-serif;
            background: var(--bg-light);
            color: var(--brand-navy);
        }

        .fa-solid,
        .fa-regular,
        .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .fa-solid {
            font-weight: 900 !important;
        }

        .main-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--brand-navy);
            text-decoration: none;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            border: 1px solid var(--brand-gold);
            color: var(--brand-gold-light);
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            line-height: 1;
        }

        .brand-name span {
            color: var(--brand-gold);
        }

        .brand-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .nav-link {
            color: var(--brand-navy) !important;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--brand-gold) !important;
        }

        .btn {
            font-weight: 700;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-navy {
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-navy:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .btn-gold {
            background: var(--brand-gold) !important;
            border-color: var(--brand-gold) !important;
            color: #ffffff !important;
        }

        .btn-gold:hover {
            background: var(--brand-gold-hover) !important;
            border-color: var(--brand-gold-hover) !important;
        }

        .btn-outline-navy {
            background: transparent !important;
            border: 1px solid var(--brand-navy) !important;
            color: var(--brand-navy) !important;
        }

        .btn-outline-navy:hover {
            background: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .page-content {
            flex: 1 0 auto;
            width: 100%;
            padding: 40px 0 60px;
        }

        .page-header {
            padding: 40px 0 25px;
        }

        .page-title {
            font-weight: 800;
            color: var(--brand-navy);
        }

        .page-subtitle {
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .card {
            border: 1px solid var(--border-color);
            border-radius: 18px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
        }

        .insight-card {
            background: #ffffff;
            padding: 30px;
        }

        .ai-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-navy);
            color: var(--brand-gold-light);
            font-size: 22px;
        }

        .summary-text {
            font-size: 16px;
            line-height: 1.8;
            color: #374151;
        }

        .tip-card {
            background: #f8fafc;
            border-left: 4px solid var(--brand-navy);
            padding: 20px;
            border-radius: 12px;
        }

        .tip-title {
            font-weight: 700;
            color: var(--brand-navy);
        }

        .tip-text {
            color: #4b5563;
            margin-bottom: 0;
            line-height: 1.7;
        }

        .history-item {
            display: block;
            text-decoration: none;
            color: inherit;
            padding: 18px;
            border-bottom: 1px solid var(--border-color);
        }

        .history-item:last-child {
            border-bottom: none;
        }

        .history-item:hover {
            background: #f9fafb;
        }

        .history-month {
            font-weight: 700;
            color: var(--brand-navy);
        }

        .history-date {
            font-size: 13px;
            color: var(--text-muted);
        }

        .btn-dark {
            border-radius: 10px;
            padding: 10px 18px;
            font-weight: 600;
            background: var(--brand-navy) !important;
            border-color: var(--brand-navy) !important;
            color: #ffffff !important;
        }

        .btn-dark:hover {
            background: var(--brand-navy-light) !important;
            border-color: var(--brand-navy-light) !important;
        }

        .month-input {
            border-radius: 10px;
            min-height: 44px;
            border: 1px solid var(--border-color);
        }

        .month-input:focus {
            border-color: var(--brand-gold);
            box-shadow: 0 0 0 0.2rem rgba(217, 119, 6, 0.15);
        }

        /* =========================================
           LOADER OVERLAY
           ========================================= */

        .loader-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }

        .loader-overlay.active {
            display: flex;
        }

        .loader-box {
            background: #ffffff;
            padding: 40px 44px;
            border-radius: 18px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 360px;
        }

        .loader-spinner {
            width: 56px;
            height: 56px;
            margin: 0 auto 22px;
            border: 4px solid var(--border-color);
            border-top-color: var(--brand-gold);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .loader-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--brand-navy);
            margin-bottom: 8px;
        }

        .loader-text {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.6;
        }

        footer {
            padding: 24px 0;
            background: var(--brand-navy);
            color: #94a3b8;
            border-top: 1px solid #334155;
            flex-shrink: 0;
            width: 100%;
        }

        footer p {
            margin: 0;
            font-size: 0.72rem;
        }

        footer strong {
            color: #ffffff;
        }

        @@media (max-width: 991px) {

            .navbar-nav {
                margin-top: 10px;
            }

        }

        @@media (max-width: 768px) {

            .page-header {
                padding: 30px 0 20px;
            }

            .insight-card {
                padding: 20px;
            }

            .loader-box {
                padding: 32px 26px;
                margin: 0 16px;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg main-navbar">

        <div class="container-fluid px-4 px-lg-5">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-coins"></i>
                </div>

                <div>

                    <div class="brand-name">
                        CAMPUS<span>COIN</span>
                    </div>

                    <span class="brand-subtitle">
                        Smart Student Budgeting
                    </span>

                </div>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#studentNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="studentNavbar">

                <div class="navbar-nav mx-auto">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">
                        Dashboard
                    </a>

                    <a asp-controller="Transactions"
                       asp-action="Index"
                       class="nav-link">
                        Transactions
                    </a>

                    <a asp-controller="Budgets"
                       asp-action="Index"
                       class="nav-link">
                        Budgets
                    </a>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="nav-link">
                        Categories
                    </a>

                    <a asp-controller="SavingTips"
                       asp-action="Index"
                       class="nav-link">
                        Saving Tips
                    </a>

                    <a asp-controller="Bookmarks"
                       asp-action="Index"
                       class="nav-link">
                        Bookmarks
                    </a>

                    <a asp-controller="Notes"
                       asp-action="Index"
                       class="nav-link">
                        Notes
                    </a>

                </div>

                <div class="d-flex align-items-center gap-2">

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-navy btn-sm">

                        <i class="fa-solid fa-user me-1"></i>
                        Profile

                    </a>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-navy btn-sm">

                            <i class="fa-solid fa-right-from-bracket me-1"></i>
                            Logout

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </nav>

    <main class="page-content">

        <div class="container">

            <section class="page-header">

                <div class="row align-items-center">

                    <div class="col-lg-8">

                        <h1 class="page-title">

                            <i class="fa-solid fa-wand-magic-sparkles me-2"></i>
                            AI Spending Insights

                        </h1>

                        <p class="page-subtitle mb-0">
                            Understand your monthly spending patterns with
                            AI-generated summaries and practical budgeting advice.
                        </p>

                    </div>

                    <div class="col-lg-4 mt-4 mt-lg-0">

                        <form asp-action="Index"
                              method="get"
                              class="d-flex gap-2">

                            <input type="month"
                                   name="month"
                                   value="@selectedMonth"
                                   class="form-control month-input" />

                            <button type="submit"
                                    class="btn btn-dark">
                                View
                            </button>

                        </form>

                    </div>

                </div>

            </section>

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success">

                    <i class="fa-solid fa-circle-check me-2"></i>
                    @successMessage

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @errorMessage

                </div>
            }

            <div class="row g-4">

                <div class="col-lg-8">

                    <div class="card insight-card">

                        <div class="d-flex align-items-center mb-4">

                            <div class="ai-icon me-3">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </div>

                            <div>

                                <h4 class="mb-1 fw-bold">
                                    @monthDisplay
                                </h4>

                                <div class="text-muted">
                                    Monthly spending analysis
                                </div>

                            </div>

                        </div>

                        @if (insight != null)
                        {
                            <h5 class="fw-bold mb-3">
                                Spending Summary
                            </h5>

                            <p class="summary-text">
                                @insight.SummaryText
                            </p>

                            @if (!string.IsNullOrWhiteSpace(insight.TipText))
                            {
                                <div class="tip-card mt-4">

                                    <div class="tip-title mb-2">

                                        <i class="fa-solid fa-lightbulb me-2"></i>
                                        Suggested Action

                                    </div>

                                    <p class="tip-text">
                                        @insight.TipText
                                    </p>

                                </div>
                            }

                            <div class="d-flex justify-content-between
                                        align-items-center mt-4">

                                <small class="text-muted">
                                    Generated
                                    @insight.GeneratedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </small>

                                <form asp-action="Regenerate"
                                      method="post"
                                      class="ai-action-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="month"
                                           value="@selectedMonth" />

                                    <button type="submit"
                                            class="btn btn-outline-dark">

                                        <i class="fa-solid fa-rotate me-2"></i>
                                        Regenerate

                                    </button>

                                </form>

                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">

                                <i class="fa-solid fa-chart-line mb-3"
                                   style="font-size: 42px; color: #9ca3af;">
                                </i>

                                <h5 class="fw-bold">
                                    No AI insight yet
                                </h5>

                                <p class="text-muted mb-4">
                                    Generate an AI analysis of your spending
                                    for @monthDisplay.
                                </p>

                                <form asp-action="Generate"
                                      method="post"
                                      class="ai-action-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="month"
                                           value="@selectedMonth" />

                                    <button type="submit"
                                            class="btn btn-dark">

                                        <i class="fa-solid fa-wand-magic-sparkles me-2"></i>
                                        Generate AI Insight

                                    </button>

                                </form>

                            </div>
                        }

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="card">

                        <div class="p-4 border-bottom">

                            <h5 class="fw-bold mb-1">
                                Insight History
                            </h5>

                            <small class="text-muted">
                                Your previous monthly insights
                            </small>

                        </div>

                        @if (history.Count > 0)
                        {
                            foreach (var item in history)
                            {
                                <a asp-action="Index"
                                   asp-route-month="@item.Month.ToString("yyyy-MM")"
                                   class="history-item">

                                    <div class="d-flex justify-content-between">

                                        <span class="history-month">
                                            @item.Month.ToString("MMMM yyyy")
                                        </span>

                                        <i class="fa-solid fa-chevron-right
                                                  text-muted">
                                        </i>

                                    </div>

                                    <div class="history-date mt-1">
                                        Generated
                                        @item.GeneratedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>

                                </a>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center">

                                <i class="fa-regular fa-clock mb-3"
                                   style="font-size: 32px; color: #9ca3af;">
                                </i>

                                <p class="text-muted mb-0">
                                    No previous insights yet.
                                </p>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </main>

    <footer>

        <div class="container-fluid px-4 px-lg-5">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">

                <p>
                    <strong>CampusCoin</strong>
                    · Smart Student Budgeting Platform
                </p>

                <p>
                    © 2026 CampusCoin
                </p>

            </div>

        </div>

    </footer>


    <!-- =========================================
         LOADER OVERLAY
         ========================================= -->

    <div class="loader-overlay"
         id="aiLoader">

        <div class="loader-box">

            <div class="loader-spinner"></div>

            <div class="loader-title">
                Generating your insight
            </div>

            <p class="loader-text">
                Our AI is analyzing your spending.
                This may take a few moments.
            </p>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        (function () {

            const loader = document.getElementById("aiLoader");

            document
                .querySelectorAll(".ai-action-form")
                .forEach(function (form) {

                    form.addEventListener("submit", function () {

                        loader.classList.add("active");

                        const btn = form.querySelector("button[type='submit']");

                        if (btn) {
                            btn.disabled = true;
                        }

                    });

                });

        })();

    </script>

</body>

</html>